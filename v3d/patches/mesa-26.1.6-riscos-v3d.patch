@@ -560,6 +560,20 @@
         c->debug_output_data = debug_output_data;
         c->compilation_result = V3D_COMPILATION_SUCCEEDED;
         c->min_threads_for_reg_alloc = strategy->min_threads;
+#ifdef __riscos__
+        /* riscos-mesa (v3d prototype): V3DM_THREADS 2 caps the threads
+         * every shader is compiled for at 2, to look for a fault in thread
+         * switching. (Not 1: fragment shaders compiled for one thread
+         * lose their TLB writes on V3D 4.2.) */
+        {
+                const char *t = getenv("V3DM_THREADS");
+                uint32_t n = t ? (uint32_t) atoi(t) : 0;
+                if (n == 2) {
+                        c->threads = MIN2(c->threads, n);
+                        c->min_threads_for_reg_alloc = MIN2(c->min_threads_for_reg_alloc, n);
+                }
+        }
+#endif
         c->max_tmu_spills = strategy->max_tmu_spills;
         c->fallback_scheduler = fallback_scheduler;
         c->disable_general_tmu_sched = strategy->disable_general_tmu_sched;
