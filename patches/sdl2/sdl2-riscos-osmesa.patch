+/*
+ * Software OpenGL for the RISC OS video driver, using Mesa's OSMesa.
+ *
+ * Design:
+ *  - Each GL window owns a 32bpp (type 6, 0x00BBGGRR) sprite. That byte
+ *    order is R,G,B,X in memory, which is exactly OSMESA_RGBA with
+ *    GL_UNSIGNED_BYTE, so Mesa renders straight into the sprite image with
+ *    no conversion pass. OSMESA_Y_UP is set to 0 so row 0 is the top row,
+ *    as RISC OS sprites expect.
+ *  - SwapWindow = glFinish + plot the sprite via the driver's normal
+ *    framebuffer path (RISCOS_UpdateWindowFramebuffer), so windowed /
+ *    full-screen / scaling behaviour is whatever the framebuffer path does.
+ *  - OSMesa is linked statically; GL_LoadLibrary is a no-op and
+ *    GL_GetProcAddress forwards to OSMesaGetProcAddress.
+ */
+#include "../../SDL_internal.h"
+
+#if SDL_VIDEO_DRIVER_RISCOS && SDL_VIDEO_OPENGL_OSMESA
+
+#include "../SDL_sysvideo.h"
+#include "SDL_riscosvideo.h"
+#include "SDL_riscoswindow.h"
+#include "SDL_riscosframebuffer_c.h"
+#include "SDL_riscosopengl.h"
+
+#include <kernel.h>
+#include <swis.h>
+
+/* Local OSMesa declarations (values from Mesa's GL/osmesa.h). Declared here
+   rather than including GL/gl.h so SDL's own GL headers never clash. */
+typedef struct osmesa_context *OSMesaContext;
+typedef void (*OSMESAproc)(void);
+extern OSMesaContext OSMesaCreateContextAttribs(const int *attribList, OSMesaContext sharelist);
+extern void OSMesaDestroyContext(OSMesaContext ctx);
+extern unsigned char OSMesaMakeCurrent(OSMesaContext ctx, void *buffer, unsigned int type, int width, int height);
+extern OSMesaContext OSMesaGetCurrentContext(void);
+extern void OSMesaPixelStore(int pname, int value);
+extern OSMESAproc OSMesaGetProcAddress(const char *funcName);
+
+#define RO_GL_RGBA                   0x1908
+#define RO_GL_UNSIGNED_BYTE          0x1401
+#define OSMESA_ROW_LENGTH            0x10
+#define OSMESA_Y_UP                  0x11
+#define OSMESA_FORMAT                0x22
+#define OSMESA_DEPTH_BITS            0x30
+#define OSMESA_STENCIL_BITS          0x31
+#define OSMESA_ACCUM_BITS            0x32
+#define OSMESA_PROFILE               0x33
+#define OSMESA_CORE_PROFILE          0x34
+#define OSMESA_COMPAT_PROFILE        0x35
+#define OSMESA_CONTEXT_MAJOR_VERSION 0x36
+#define OSMESA_CONTEXT_MINOR_VERSION 0x37
+
+/* 32bpp, 90x90 dpi, new-format sprite mode word: pixels are 0x00BBGGRR */
+#define GL_SPRITE_MODE (1 | (90 << 1) | (90 << 14) | (6 << 27))
+
+static void (*gl_finish)(void) = NULL;
+
+/* (Re)allocate the per-window 32bpp render sprite if the size changed. */
+static int
+RISCOS_GL_EnsureBuffer(SDL_Window *window)
+{
+    SDL_WindowData *data = (SDL_WindowData *) window->driverdata;
+    _kernel_swi_regs regs;
+    _kernel_oserror *error;
+    int pitch, size;
+
+    if (data->gl_area && data->gl_w == window->w && data->gl_h == window->h) {
+        return 0;
+    }
+
+    if (data->gl_area) {
+        SDL_free(data->gl_area);
+        data->gl_area = NULL;
+        data->gl_sprite = NULL;
+    }
+
+    pitch = window->w * 4;
+    size = sizeof(sprite_area) + sizeof(sprite_header) + pitch * window->h;
+    data->gl_area = (sprite_area *) SDL_malloc(size);
+    if (!data->gl_area) {
+        return SDL_OutOfMemory();
+    }
+    data->gl_area->size  = size;
+    data->gl_area->count = 0;
+    data->gl_area->start = 16;
+    data->gl_area->end   = 16;
+
+    regs.r[0] = 256 + 15;             /* Create sprite */
+    regs.r[1] = (int) data->gl_area;
+    regs.r[2] = (int) "gl";
+    regs.r[3] = 0;                    /* no palette */
+    regs.r[4] = window->w;
+    regs.r[5] = window->h;
+    regs.r[6] = GL_SPRITE_MODE;
+    error = _kernel_swi(OS_SpriteOp, &regs, &regs);
+    if (error != NULL) {
+        SDL_free(data->gl_area);
+        data->gl_area = NULL;
+        return SDL_SetError("Unable to create GL sprite: %s (%i)", error->errmess, error->errnum);
+    }
+
+    data->gl_sprite = (sprite_header *) (((Uint8 *) data->gl_area) + data->gl_area->start);
+    data->gl_w = window->w;
+    data->gl_h = window->h;
+    return 0;
+}
+
+static void *
+RISCOS_GL_Pixels(SDL_WindowData *data)
+{
+    return ((Uint8 *) data->gl_sprite) + data->gl_sprite->image_offset;
+}
+
+int
+RISCOS_GL_LoadLibrary(_THIS, const char *path)
+{
+    /* OSMesa is statically linked; nothing to load. */
+    (void) path;
+    SDL_strlcpy(_this->gl_config.driver_path, "OSMesa", sizeof(_this->gl_config.driver_path));
+    return 0;
+}
+
+void *
+RISCOS_GL_GetProcAddress(_THIS, const char *proc)
+{
+    (void) _this;
+    return (void *) OSMesaGetProcAddress(proc);
+}
+
+void
+RISCOS_GL_UnloadLibrary(_THIS)
+{
+    (void) _this;
+}
+
+SDL_GLContext
+RISCOS_GL_CreateContext(_THIS, SDL_Window *window)
+{
+    OSMesaContext share = NULL;
+    OSMesaContext ctx;
+    int attribs[20];
+    int n = 0;
+
+    if (_this->gl_config.share_with_current_context) {
+        share = (OSMesaContext) SDL_GL_GetCurrentContext();
+    }
+
+    attribs[n++] = OSMESA_FORMAT;       attribs[n++] = RO_GL_RGBA;
+    attribs[n++] = OSMESA_DEPTH_BITS;   attribs[n++] = _this->gl_config.depth_size;
+    attribs[n++] = OSMESA_STENCIL_BITS; attribs[n++] = _this->gl_config.stencil_size;
+    attribs[n++] = OSMESA_ACCUM_BITS;   attribs[n++] = _this->gl_config.accum_red_size ? 16 : 0;
+
+    if (_this->gl_config.profile_mask == SDL_GL_CONTEXT_PROFILE_ES) {
+        SDL_SetError("OpenGL ES contexts are not supported by the OSMesa backend");
+        return NULL;
+    }
+    if (_this->gl_config.profile_mask == SDL_GL_CONTEXT_PROFILE_CORE) {
+        attribs[n++] = OSMESA_PROFILE;  attribs[n++] = OSMESA_CORE_PROFILE;
+    } else {
+        attribs[n++] = OSMESA_PROFILE;  attribs[n++] = OSMESA_COMPAT_PROFILE;
+    }
+    /* SDL defaults to 2.1 compat; only pass a version when the app set one. */
+    if (_this->gl_config.major_version > 2 ||
+        _this->gl_config.profile_mask == SDL_GL_CONTEXT_PROFILE_CORE) {
+        attribs[n++] = OSMESA_CONTEXT_MAJOR_VERSION; attribs[n++] = _this->gl_config.major_version;
+        attribs[n++] = OSMESA_CONTEXT_MINOR_VERSION; attribs[n++] = _this->gl_config.minor_version;
+    }
+    attribs[n++] = 0;
+
+    ctx = OSMesaCreateContextAttribs(attribs, share);
+    if (!ctx) {
+        SDL_SetError("OSMesaCreateContextAttribs failed (requested GL %d.%d)",
+                     _this->gl_config.major_version, _this->gl_config.minor_version);
+        return NULL;
+    }
+
+    if (RISCOS_GL_MakeCurrent(_this, window, (SDL_GLContext) ctx) < 0) {
+        OSMesaDestroyContext(ctx);
+        return NULL;
+    }
+    return (SDL_GLContext) ctx;
+}
+
+int
+RISCOS_GL_MakeCurrent(_THIS, SDL_Window *window, SDL_GLContext context)
+{
+    SDL_WindowData *data;
+    (void) _this;
+
+    if (!window || !context) {
+        /* OSMesa has no "release" call; nothing to do. */
+        return 0;
+    }
+
+    if (RISCOS_GL_EnsureBuffer(window) < 0) {
+        return -1;
+    }
+    data = (SDL_WindowData *) window->driverdata;
+
+    if (!OSMesaMakeCurrent((OSMesaContext) context, RISCOS_GL_Pixels(data),
+                           RO_GL_UNSIGNED_BYTE, data->gl_w, data->gl_h)) {
+        return SDL_SetError("OSMesaMakeCurrent failed");
+    }
+    OSMesaPixelStore(OSMESA_Y_UP, 0);   /* sprite rows run top-down */
+    OSMesaPixelStore(OSMESA_ROW_LENGTH, data->gl_w);
+
+    if (!gl_finish) {
+        gl_finish = (void (*)(void)) OSMesaGetProcAddress("glFinish");
+    }
+    return 0;
+}
+
+void
+RISCOS_GL_GetDrawableSize(_THIS, SDL_Window *window, int *w, int *h)
+{
+    (void) _this;
+    if (w) *w = window->w;
+    if (h) *h = window->h;
+}
+
+int
+RISCOS_GL_SetSwapInterval(_THIS, int interval)
+{
+    SDL_VideoData *vdata = (SDL_VideoData *) _this->driverdata;
+    if (interval < 0) {
+        interval = 1;   /* no adaptive vsync; treat as vsync */
+    }
+    vdata->gl_swap_interval = interval;
+    return 0;
+}
+
+int
+RISCOS_GL_GetSwapInterval(_THIS)
+{
+    SDL_VideoData *vdata = (SDL_VideoData *) _this->driverdata;
+    return vdata->gl_swap_interval;
+}
+
+int
+RISCOS_GL_SwapWindow(_THIS, SDL_Window *window)
+{
+    SDL_WindowData *data = (SDL_WindowData *) window->driverdata;
+    SDL_VideoData *vdata = (SDL_VideoData *) _this->driverdata;
+    sprite_area *saved_area;
+    sprite_header *saved_sprite;
+    _kernel_swi_regs regs;
+    int result;
+
+    if (!data->gl_area) {
+        return SDL_SetError("No GL buffer for this window");
+    }
+
+    if (gl_finish) {
+        gl_finish();
+    }
+
+    if (vdata->gl_swap_interval > 0) {
+        regs.r[0] = 19;                 /* OS_Byte 19: wait for vertical sync */
+        _kernel_swi(OS_Byte, &regs, &regs);
+    }
+
+    /* Plot through the driver's framebuffer path, temporarily pointing it at
+       the GL sprite. Keeps windowed/full-screen handling in one place. */
+    saved_area = data->fb_area;
+    saved_sprite = data->fb_sprite;
+    data->fb_area = data->gl_area;
+    data->fb_sprite = data->gl_sprite;
+    result = RISCOS_UpdateWindowFramebuffer(_this, window, NULL, 0);
+    data->fb_area = saved_area;
+    data->fb_sprite = saved_sprite;
+
+    /* Window resized since last frame: rebind a correctly sized buffer. */
+    if (data->gl_w != window->w || data->gl_h != window->h) {
+        OSMesaContext cur = OSMesaGetCurrentContext();
+        if (cur) {
+            RISCOS_GL_MakeCurrent(_this, window, (SDL_GLContext) cur);
+        }
+    }
+    return result;
+}
+
+void
+RISCOS_GL_DeleteContext(_THIS, SDL_GLContext context)
+{
+    (void) _this;
+    if (context) {
+        OSMesaDestroyContext((OSMesaContext) context);
+    }
+}
+
+void
+RISCOS_GL_DestroyWindowBuffer(SDL_Window *window)
+{
+    SDL_WindowData *data = (SDL_WindowData *) window->driverdata;
+    if (data && data->gl_area) {
+        SDL_free(data->gl_area);
+        data->gl_area = NULL;
+        data->gl_sprite = NULL;
+        data->gl_w = data->gl_h = 0;
+    }
+}
+
+#endif /* SDL_VIDEO_DRIVER_RISCOS && SDL_VIDEO_OPENGL_OSMESA */
+
+/* vi: set ts=4 sw=4 expandtab: */
