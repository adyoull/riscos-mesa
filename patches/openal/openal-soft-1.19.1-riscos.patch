-#ifdef HAVE_NEON
+#if defined(HAVE_NEON) && defined(__riscos__)
+    /* RISC OS has no /proc/cpuinfo: VFPSupport_Features (reason 0) gives
+     * MVFR1 in R2, whose Advanced SIMD fields (load/store, integer, single
+     * precision: bits 8-19) are all 1 when the CPU has NEON. No VFPSupport
+     * (or an old one without the SWI): no NEON. The system variable
+     * OpenAL$NoNEON (any value) leaves the C mixers in use. */
+    {
+        _kernel_swi_regs r;
+        r.r[0] = 0;
+        if(getenv("OpenAL$NoNEON") == NULL &&
+           _kernel_swi(VFPSupport_Features, &r, &r) == NULL &&
+           (r.r[2] & 0xFFF00) == 0x11100)
+            caps |= CPU_CAP_NEON;
+    }
+#elif defined(HAVE_NEON)
     FILE *file = fopen("/proc/cpuinfo", "rt");
     if(!file)
         ERR("Failed to open /proc/cpuinfo, cannot check for NEON support\n");
