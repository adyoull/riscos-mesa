--- a/src/mapi/glapi/glapi_getproc.c
+++ b/src/mapi/glapi/glapi_getproc.c
@@ -33,6 +33,8 @@
 #include <assert.h>
 #include <string.h>
 #include <stdlib.h>
+#include "c11/threads.h"
+#include "util/macros.h"
 #include "glapi/glapi_priv.h"
 #include "glapitable.h"
 
@@ -52,6 +54,49 @@
 #include "glprocs.h"
 
 
+/*
+ * riscos-mesa: static functions are found by binary search in an index
+ * sorted by name, not by comparing the name with every entry in turn.
+ * Mesa looks up about 2500 names in this 2300-entry table when the first
+ * context is created (_mesa_init_remap_table), which took ~87 million
+ * instructions (~0.1 s on a Raspberry Pi 4) before any GL was drawn;
+ * GetProcAddress lookups use it too. The result is the same entry the
+ * linear search returned: the first one in table order with that name.
+ */
+
+/* static_functions[] ends with an entry whose Name_offset is -1 */
+#define NUM_STATIC_FUNCTIONS (ARRAY_SIZE(static_functions) - 1)
+
+/* Indices into static_functions[], sorted by name, then by index */
+static unsigned short static_by_name[NUM_STATIC_FUNCTIONS];
+
+static const char *
+static_proc_name(unsigned i)
+{
+   return gl_string_table + static_functions[i].Name_offset;
+}
+
+static int
+compare_static_procs(const void *a, const void *b)
+{
+   const unsigned i = *(const unsigned short *) a;
+   const unsigned j = *(const unsigned short *) b;
+   const int c = strcmp(static_proc_name(i), static_proc_name(j));
+   return c != 0 ? c : (int) i - (int) j;
+}
+
+static void
+build_static_index(void)
+{
+   unsigned i;
+   STATIC_ASSERT(NUM_STATIC_FUNCTIONS <= 0xffff);
+   assert(static_functions[NUM_STATIC_FUNCTIONS].Name_offset < 0);
+   for (i = 0; i < NUM_STATIC_FUNCTIONS; i++)
+      static_by_name[i] = i;
+   qsort(static_by_name, NUM_STATIC_FUNCTIONS, sizeof(static_by_name[0]),
+         compare_static_procs);
+}
+
 /**
  * Search the table of static entrypoint functions for the named function
  * and return the corresponding glprocs_table_t entry.
@@ -59,14 +104,22 @@
 static const glprocs_table_t *
 get_static_proc( const char * n )
 {
-   GLuint i;
-   for (i = 0; static_functions[i].Name_offset >= 0; i++) {
-      const char *testName = gl_string_table + static_functions[i].Name_offset;
-      if (strcmp(testName, n) == 0)
-      {
-	 return &static_functions[i];
-      }
+   static once_flag index_built = ONCE_FLAG_INIT;
+   unsigned lo = 0, hi = NUM_STATIC_FUNCTIONS;
+
+   call_once(&index_built, build_static_index);
+
+   /* Find the first index entry whose name is >= n */
+   while (lo < hi) {
+      const unsigned mid = lo + (hi - lo) / 2;
+      if (strcmp(static_proc_name(static_by_name[mid]), n) < 0)
+         lo = mid + 1;
+      else
+         hi = mid;
    }
+   if (lo < NUM_STATIC_FUNCTIONS &&
+       strcmp(static_proc_name(static_by_name[lo]), n) == 0)
+      return &static_functions[static_by_name[lo]];
    return NULL;
 }
 
