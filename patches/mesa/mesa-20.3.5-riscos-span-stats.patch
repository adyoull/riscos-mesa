+/**
+ * riscos-mesa: MESA_STATS. When the variable MESA_STATS names a file, the
+ * spans written are counted, and the counts are written to that file
+ * when the program ends: depth-tested spans that took the fast route
+ * (ro_write_rgba_span_fast), textured by the fast textured triangles or
+ * not, with how many of their fragments passed the depth test (the share
+ * of texturing work that was kept); and spans that took the general
+ * route, with the commonest reasons (also written every 500 depth buffer
+ * clears). For finding out what a program draws; it changes nothing
+ * drawn. Off (one test of a flag per span)
+ * when the variable isn't set.
+ */
+int _mesa_ro_stats_state = -1;
+int _mesa_ro_stats_tex;
+
+static struct {
+   char file[256];
+   unsigned long long fast_spans[2], fast_frags[2], fast_passed[2];
+   unsigned long long gen_spans[2][2], gen_frags[2][2];  /* [textured][depth test] */
+   unsigned long long gen_stencil, gen_alpha, gen_blend, gen_fog, gen_clipped;
+   unsigned long long depth_clears;
+} ro_stats;
+
+static double
+ro_pc(unsigned long long a, unsigned long long b)
+{
+   return b ? 100.0 * (double) a / (double) b : 0.0;
+}
+
+static void
+ro_stats_write(void)
+{
+   FILE *f = fopen(ro_stats.file, "w");
+   int t, d;
+   if (!f)
+      return;
+   fprintf(f, "riscos-mesa MESA_STATS\n\n"
+           "Depth buffer clears (about one a frame): %llu\n\n"
+           "Depth-tested spans written by the fast route:\n",
+           ro_stats.depth_clears);
+   for (t = 1; t >= 0; t--)
+      fprintf(f, "  %-10s %12llu spans %14llu fragments, %14llu passed the depth test (%.1f%%)\n",
+              t ? "textured" : "untextured", ro_stats.fast_spans[t],
+              ro_stats.fast_frags[t], ro_stats.fast_passed[t],
+              ro_pc(ro_stats.fast_passed[t], ro_stats.fast_frags[t]));
+   fprintf(f, "\nSpans written by the general route:\n");
+   for (t = 1; t >= 0; t--)
+      for (d = 1; d >= 0; d--)
+         fprintf(f, "  %-10s %-15s %12llu spans %14llu fragments\n",
+                 t ? "textured" : "untextured",
+                 d ? "depth-tested" : "no depth test",
+                 ro_stats.gen_spans[t][d], ro_stats.gen_frags[t][d]);
+   fprintf(f, "  of those spans: %llu with a stencil test, %llu alpha test, "
+           "%llu blended, %llu fogged, %llu cut by the window or scissor box\n",
+           ro_stats.gen_stencil, ro_stats.gen_alpha, ro_stats.gen_blend,
+           ro_stats.gen_fog, ro_stats.gen_clipped);
+   fclose(f);
+}
+
+static int
+ro_stats_init(void)
+{
+   const char *v = getenv("MESA_STATS");
+   if (v && *v && strlen(v) < sizeof ro_stats.file) {
+      strcpy(ro_stats.file, v);
+      atexit(ro_stats_write);
+      _mesa_ro_stats_state = 1;
+   }
+   else
+      _mesa_ro_stats_state = 0;
+   return _mesa_ro_stats_state;
+}
+
+void
+_mesa_ro_stats_depth_clear(void)
+{
+   /* the file is also written every 500 clears, in case the program
+    * doesn't end normally */
+   if ((_mesa_ro_stats_state > 0 || ro_stats_init()) &&
+       ++ro_stats.depth_clears % 500 == 0)
+      ro_stats_write();
+}
+
+/* a span that took the general route */
+static void
+ro_stats_general(struct gl_context *ctx, const SWspan *span)
+{
+   const struct gl_framebuffer *fb = ctx->DrawBuffer;
+   const int t = _mesa_ro_stats_tex || ctx->Texture._EnabledCoordUnits ||
+                 _swrast_use_fragment_program(ctx);
+   const int d = ctx->Depth.Test;
+   if (_mesa_ro_stats_state < 0 && !ro_stats_init())
+      return;
+   ro_stats.gen_spans[t][d]++;
+   ro_stats.gen_frags[t][d] += span->end;
+   ro_stats.gen_stencil += _mesa_stencil_is_enabled(ctx);
+   ro_stats.gen_alpha += ctx->Color.AlphaEnabled;
+   ro_stats.gen_blend += ctx->Color.BlendEnabled & 1;
+   ro_stats.gen_fog += SWRAST_CONTEXT(ctx)->_FogEnabled;
+   if (!(span->arrayMask & SPAN_XY) &&
+       (span->y < fb->_Ymin || span->y >= fb->_Ymax ||
+        span->x < fb->_Xmin || span->x + (GLint) span->end > fb->_Xmax))
+      ro_stats.gen_clipped++;
+}
+
