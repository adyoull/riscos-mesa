+/*
+ * riscos-mesa: buffers owned by the caller, for EGL surfaces.
+ *
+ * An OSMesaBuffer is a drawable of its own: its colour buffer is memory
+ * the caller supplies (32-bit OSMESA_RGBA or OSMESA_BGRA pixels, as
+ * GL_UNSIGNED_BYTE), and its depth and stencil buffers belong to it rather
+ * than to a context. So several contexts drawing into it in turn share its
+ * depth buffer, as EGL requires, and a context can draw into one buffer
+ * and read (glReadPixels, glCopyTexImage...) from another.
+ *
+ *   OSMesaCreateBuffer    format, and the depth and stencil sizes (0 for
+ *                         none); NULL if not supported
+ *   OSMesaBufferStorage   the colour memory: size, pixels from one row to
+ *                         the next, and whether row 0 is the bottom (yup)
+ *                         or the top. Takes effect at the next
+ *                         OSMesaMakeCurrentBuffers; depth and stencil are
+ *                         reallocated (cleared) only when the size changes.
+ *   OSMesaMakeCurrentBuffers  bind a context to a draw and a read buffer
+ *                         (the same one for both is normal); their format
+ *                         must be the context's.
+ *   OSMesaDestroyBuffer   free it (a context it is bound to keeps it until
+ *                         it is bound to something else).
+ */
+typedef struct osmesa_buffer *OSMesaBuffer;
+
+GLAPI OSMesaBuffer GLAPIENTRY
+OSMesaCreateBuffer(GLenum format, GLint depthBits, GLint stencilBits);
+
+GLAPI void GLAPIENTRY
+OSMesaDestroyBuffer(OSMesaBuffer buffer);
+
+GLAPI GLboolean GLAPIENTRY
+OSMesaBufferStorage(OSMesaBuffer buffer, void *pixels, GLsizei width,
+                    GLsizei height, GLint rowLength, GLboolean yup);
+
+GLAPI GLboolean GLAPIENTRY
+OSMesaMakeCurrentBuffers(OSMesaContext ctx, OSMesaBuffer draw,
+                         OSMesaBuffer read);
+
+
