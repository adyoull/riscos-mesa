+/**********************************************************************/
+/*****        riscos-mesa: buffers owned by the caller (EGL surfaces)  *****/
+/**********************************************************************/
+
+static GLboolean
+osmesa_buffer_rb_storage(struct gl_context *ctx, struct gl_renderbuffer *rb,
+                         GLenum internalFormat, GLuint width, GLuint height)
+{
+   const struct osmesa_buffer_rb *brb = (const struct osmesa_buffer_rb *) rb;
+
+   (void) ctx;
+   (void) internalFormat;
+#if UTIL_ARCH_LITTLE_ENDIAN
+   rb->Format = brb->Format == OSMESA_BGRA ? MESA_FORMAT_B8G8R8A8_UNORM
+                                           : MESA_FORMAT_R8G8B8A8_UNORM;
+#else
+   rb->Format = brb->Format == OSMESA_BGRA ? MESA_FORMAT_A8R8G8B8_UNORM
+                                           : MESA_FORMAT_A8B8G8R8_UNORM;
+#endif
+   rb->Width = width;
+   rb->Height = height;
+   return GL_TRUE;
+}
+
+
+GLAPI OSMesaBuffer GLAPIENTRY
+OSMesaCreateBuffer(GLenum format, GLint depthBits, GLint stencilBits)
+{
+   struct osmesa_buffer *buf;
+   struct gl_config *visual;
+
+   if ((format != OSMESA_RGBA && format != OSMESA_BGRA) ||
+       depthBits < 0 || depthBits > 32 || stencilBits < 0 || stencilBits > 8)
+      return NULL;
+
+   buf = CALLOC_STRUCT(osmesa_buffer);
+   if (!buf)
+      return NULL;
+   visual = _mesa_create_visual(GL_FALSE, GL_FALSE, 8, 8, 8, 8,
+                                depthBits, stencilBits, 0, 0, 0, 0, 1);
+   if (visual) {
+      buf->fb = _mesa_create_framebuffer(visual);   /* copies the visual */
+      _mesa_destroy_visual(visual);
+   }
+   buf->rb = CALLOC_STRUCT(osmesa_buffer_rb);
+   if (!buf->fb || !buf->rb) {
+      _mesa_reference_framebuffer(&buf->fb, NULL);
+      free(buf->rb);
+      free(buf);
+      return NULL;
+   }
+
+   _mesa_init_renderbuffer(&buf->rb->Base.Base, 0);
+   buf->rb->Base.Base.ClassID = OSMESA_BUFFER_RB_CLASS;
+   buf->rb->Base.Base.Delete = osmesa_delete_renderbuffer;
+   buf->rb->Base.Base.AllocStorage = osmesa_buffer_rb_storage;
+   buf->rb->Base.Base.InternalFormat = GL_RGBA;
+   buf->rb->Base.Base._BaseFormat = GL_RGBA;
+   buf->rb->Format = format;
+   _mesa_attach_and_reference_rb(buf->fb, BUFFER_FRONT_LEFT,
+                                 &buf->rb->Base.Base);
+   _swrast_add_soft_renderbuffers(buf->fb, GL_FALSE, depthBits > 0,
+                                  stencilBits > 0, GL_FALSE, GL_FALSE,
+                                  GL_FALSE);
+   return buf;
+}
+
+
+GLAPI void GLAPIENTRY
+OSMesaDestroyBuffer(OSMesaBuffer buf)
+{
+   /* A context it is bound to keeps the framebuffer until it's unbound */
+   if (buf) {
+      _mesa_reference_framebuffer(&buf->fb, NULL);
+      free(buf);
+   }
+}
+
+
+GLAPI GLboolean GLAPIENTRY
+OSMesaBufferStorage(OSMesaBuffer buf, void *pixels, GLsizei width,
+                    GLsizei height, GLint rowLength, GLboolean yup)
+{
+   if (!buf || !pixels || width < 1 || height < 1 ||
+       width > SWRAST_MAX_WIDTH || height > SWRAST_MAX_HEIGHT ||
+       rowLength < width)
+      return GL_FALSE;
+   buf->rb->Base.Buffer = pixels;
+   buf->rb->RowLength = rowLength;
+   buf->rb->YUp = yup;
+   buf->width = width;
+   buf->height = height;
+   return GL_TRUE;
+}
+
+
+/* Give the framebuffer the size its storage has (reallocating its depth
+   and stencil buffers only when the size changes) */
+static void
+osmesa_buffer_update_size(struct gl_context *ctx, struct osmesa_buffer *buf)
+{
+   if (buf->fb->Width != (GLuint) buf->width ||
+       buf->fb->Height != (GLuint) buf->height) {
+      buf->rb->Base.Base.Width = buf->rb->Base.Base.Height = 0;
+      _mesa_resize_framebuffer(ctx, buf->fb, buf->width, buf->height);
+   }
+   _mesa_update_framebuffer_visual(ctx, buf->fb);
+}
+
+
+GLAPI GLboolean GLAPIENTRY
+OSMesaMakeCurrentBuffers(OSMesaContext osmesa, OSMesaBuffer draw,
+                         OSMesaBuffer read)
+{
+   if (!osmesa || !draw || !read || !draw->rb->Base.Buffer ||
+       !read->rb->Base.Buffer)
+      return GL_FALSE;
+   if (draw->rb->Format != osmesa->format || read->rb->Format != osmesa->format)
+      return GL_FALSE;
+
+   osmesa_update_state(&osmesa->mesa, 0);
+   osmesa->DataType = GL_UNSIGNED_BYTE;
+   osmesa_buffer_update_size(&osmesa->mesa, draw);
+   if (read != draw)
+      osmesa_buffer_update_size(&osmesa->mesa, read);
+
+   if (!_mesa_make_current(&osmesa->mesa, draw->fb, read->fb))
+      return GL_FALSE;
+
+   /* for OSMesa's own fast line and triangle functions */
+   set_row_addresses(osmesa, (GLubyte *) draw->rb->Base.Buffer, draw->height,
+                     draw->rb->RowLength * 4, draw->rb->YUp);
+   return GL_TRUE;
+}
+
