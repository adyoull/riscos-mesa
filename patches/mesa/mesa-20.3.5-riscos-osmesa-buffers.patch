+static void
+compute_row_addresses( OSMesaContext osmesa )
+{
+   GLint rowlength; /* in pixels */
+
+   if (!osmesa->srb)    /* riscos-mesa: an OSMesaBuffer is bound instead */
+      return;
+   if (osmesa->userRowLength)
+      rowlength = osmesa->userRowLength;
+   else
+      rowlength = osmesa->srb->Base.Width;
+
+   set_row_addresses(osmesa, (GLubyte *) osmesa->srb->Buffer,
+                     osmesa->srb->Base.Height,
+                     rowlength * _mesa_get_format_bytes(osmesa->srb->Base.Format),
+                     osmesa->yup);
+}
