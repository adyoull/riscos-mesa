+/**
+ * riscos-mesa: a drawable of its own (OSMesaCreateBuffer, GL/osmesa.h):
+ * a framebuffer whose colour is the caller's memory and whose depth and
+ * stencil buffers belong to it, not to a context. An EGL surface has one,
+ * so several contexts drawing into it share its depth buffer, and a
+ * context can draw into one and read from another.
+ */
+struct osmesa_buffer_rb
+{
+   struct swrast_renderbuffer Base;     /* Base.Buffer = the caller's memory */
+   GLint RowLength;                     /* pixels from one row to the next */
+   GLboolean YUp;                       /* row 0 of the memory is the bottom */
+   GLenum Format;                       /* OSMESA_RGBA or OSMESA_BGRA */
+};
+
+struct osmesa_buffer
+{
+   struct gl_framebuffer *fb;
+   struct osmesa_buffer_rb *rb;         /* also referenced by fb */
+   GLint width, height;                 /* size given by OSMesaBufferStorage */
+};
+
