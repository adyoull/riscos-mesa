+/**
+ * Store the results of the fragment program for fragment i.  Output
+ * register r is at outs + r * stride.
+ */
+static void
+store_outputs(struct gl_context *ctx, SWspan *span,
+              const struct gl_program *program, GLuint i,
+              const GLfloat *outs, GLuint stride)
+{
+   const GLbitfield64 outputsWritten = program->info.outputs_written;
+
+   /* Store result color */
+   if (outputsWritten & BITFIELD64_BIT(FRAG_RESULT_COLOR)) {
+      COPY_4V(span->array->attribs[VARYING_SLOT_COL0][i],
+              outs + FRAG_RESULT_COLOR * stride);
+   }
+   else {
+      /* Multiple drawbuffers / render targets
+       * Note that colors beyond 0 and 1 will overwrite other
+       * attributes, such as FOGC, TEX0, TEX1, etc.  That's OK.
+       */
+      GLuint buf;
+      for (buf = 0; buf < ctx->DrawBuffer->_NumColorDrawBuffers; buf++) {
+         if (outputsWritten & BITFIELD64_BIT(FRAG_RESULT_DATA0 + buf)) {
+            COPY_4V(span->array->attribs[VARYING_SLOT_COL0 + buf][i],
+                    outs + (FRAG_RESULT_DATA0 + buf) * stride);
+         }
+      }
+   }
+
+   /* Store result depth/z */
+   if (outputsWritten & BITFIELD64_BIT(FRAG_RESULT_DEPTH)) {
+      const GLfloat depth = outs[FRAG_RESULT_DEPTH * stride + 2];
+      if (depth <= 0.0F)
+         span->array->z[i] = 0;
+      else if (depth >= 1.0F)
+         span->array->z[i] = ctx->DrawBuffer->_DepthMax;
+      else
+         span->array->z[i] =
+            (GLuint) (depth * ctx->DrawBuffer->_DepthMaxF + 0.5F);
+   }
+}
+
+
+/**
+ * riscos-mesa: run the program for the fragments cols[0..n-1] together
+ * (their inputs already set up by init_machine).
+ */
+static void
+run_batch(struct gl_context *ctx, SWspan *span,
+          const struct gl_program *program,
+          struct gl_program_machine *machine, const GLuint *cols, GLuint n)
+{
+   const GLint64 killed =
+      _mesa_execute_program_batch(ctx, program, machine, cols, n);
+   GLuint j;
+
+   for (j = 0; j < n; j++) {
+      const GLuint i = cols[j];
+      if (killed < 0) {
+         /* a runaway loop: run them one at a time, which stops each
+          * fragment after the same number of instructions as always */
+         machine->CurElement = i;
+         machine->StackDepth = 0;
+         if (_mesa_execute_program(ctx, program, machine)) {
+            store_outputs(ctx, span, program, i, machine->Outputs[0], 4);
+            continue;
+         }
+      }
+      else if (!(killed & (1u << j))) {
+         store_outputs(ctx, span, program, i,
+                       _mesa_program_batch_output(machine, 0, j),
+                       PROG_BATCH_LANES * 4);
+         continue;
+      }
+      /* killed fragment */
+      span->array->mask[i] = GL_FALSE;
+      span->writeAll = GL_FALSE;
+   }
+}
