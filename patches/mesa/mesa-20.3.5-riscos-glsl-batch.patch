+/*
+ * riscos-mesa: batch execution of fragment programs (the "level 2" speed-up).
+ *
+ * _mesa_execute_program runs the whole program for one fragment at a
+ * time.  _mesa_execute_program_batch runs it for up to PB_LANES fragments
+ * together: each instruction is decoded and dispatched once and then
+ * applied to every active fragment ("lane").  The per-lane arithmetic is
+ * the code of _mesa_execute_program itself (generated from it), so the
+ * results are the same bit for bit.
+ *
+ * Control flow is followed with lane masks: IF/ELSE/ENDIF, loops with
+ * BRK and CONT, KIL and a RET from main.  Programs with subroutines
+ * (CAL) aren't run in batches.  Each lane has its own address register.
+ * Temporaries and outputs are kept per lane in dec->btemps and
+ * dec->bouts ([register][lane][4]).
+ */
+
+static const GLfloat *
+lane_src_pointer(const struct gl_program *prog, const struct prog_decoded *dec,
+                 const struct gl_program_machine *machine,
+                 const struct prog_src_register *source,
+                 const GLuint *cols, const GLint *laneAddr, GLuint k)
+{
+   GLint reg = source->Index;
+
+   if (source->RelAddr) {
+      reg += laneAddr[k];
+      if (reg < 0)
+         return ZeroVec;
+   }
+
+   switch (source->File) {
+   case PROGRAM_TEMPORARY:
+      if (reg >= MAX_PROGRAM_TEMPS)
+         return ZeroVec;
+      return dec->btemps + ((GLuint) reg * PB_LANES + k) * 4;
+   case PROGRAM_INPUT:
+      if (reg >= VARYING_SLOT_MAX)
+         return ZeroVec;
+      return machine->Attribs[reg][cols[k]];
+   case PROGRAM_OUTPUT:
+      if (reg >= MAX_PROGRAM_OUTPUTS)
+         return ZeroVec;
+      return dec->bouts + ((GLuint) reg * PB_LANES + k) * 4;
+   case PROGRAM_STATE_VAR:
+   case PROGRAM_CONSTANT:
+   case PROGRAM_UNIFORM: {
+      if (reg >= (GLint) prog->Parameters->NumParameters)
+         return ZeroVec;
+      unsigned pvo = prog->Parameters->ParameterValueOffset[reg];
+      return (GLfloat *) prog->Parameters->ParameterValues + pvo;
+   }
+   case PROGRAM_SYSTEM_VALUE:
+      assert(reg < (GLint) ARRAY_SIZE(machine->SystemValues));
+      return machine->SystemValues[reg];
+   default:
+      _mesa_problem(NULL,
+         "Invalid src register file %d in get_src_register_pointer()",
+         source->File);
+      return ZeroVec;
+   }
+}
+
+
+static GLfloat *
+lane_dst_pointer(const struct prog_decoded *dec,
+                 const struct prog_dst_register *dest,
+                 const GLint *laneAddr, GLuint k)
+{
+   static GLfloat dummyReg[4];
+   GLint reg = dest->Index;
+
+   if (dest->RelAddr) {
+      reg += laneAddr[k];
+      if (reg < 0)
+         return dummyReg;
+   }
+
+   switch (dest->File) {
+   case PROGRAM_TEMPORARY:
+      if (reg >= MAX_PROGRAM_TEMPS)
+         return dummyReg;
+      return dec->btemps + ((GLuint) reg * PB_LANES + k) * 4;
+   case PROGRAM_OUTPUT:
+      if (reg >= MAX_PROGRAM_OUTPUTS)
+         return dummyReg;
+      return dec->bouts + ((GLuint) reg * PB_LANES + k) * 4;
+   default:
+      _mesa_problem(NULL,
+         "Invalid dest register file %d in get_dst_register_pointer()",
+         dest->File);
+      return dummyReg;
+   }
+}
+
+
+#undef FETCH4
+#undef FETCH1
+#undef STORE4
+
+/* Operand details copied to locals once per instruction (see PREP_OPS),
+ * so they aren't reloaded for every lane: Mesa is built with
+ * -fno-strict-aliasing, so any float store could otherwise change them.
+ */
+#define PREP_SRC(N)                                                   \
+   GLfloat *const *lb##N = lb[di->src[N].base];                       \
+   const GLint bo##N = di->src[N].boff;                               \
+   const GLuint fl##N = di->src[N].flags;                             \
+   const GLuint sx##N = di->src[N].swz[0], sy##N = di->src[N].swz[1], \
+                sz##N = di->src[N].swz[2], sw##N = di->src[N].swz[3];
+#define PREP_OPS                                                      \
+   PREP_SRC(0) PREP_SRC(1) PREP_SRC(2)                                \
+   GLfloat *const *lbd = lb[di->dst.base];                            \
+   const GLint bod = di->dst.boff;                                    \
+   const GLuint dslow = di->dst.slow;                                 \
+   const GLuint wmask = inst->DstReg.WriteMask;                       \
+   const GLuint dsat = inst->Saturate;                                \
+   (void) lb0; (void) bo0; (void) fl0; (void) sx0; (void) sy0;        \
+   (void) sz0; (void) sw0; (void) lb1; (void) bo1; (void) fl1;        \
+   (void) sx1; (void) sy1; (void) sz1; (void) sw1; (void) lb2;        \
+   (void) bo2; (void) fl2; (void) sx2; (void) sy2; (void) sz2;        \
+   (void) sw2; (void) lbd; (void) bod; (void) dslow; (void) wmask;    \
+   (void) dsat;
+
+#define LSRC(N)                                                       \
+   (unlikely(fl##N & PF_SLOW) ?                                       \
+    lane_src_pointer(program, dec, machine, &inst->SrcReg[N], cols, laneAddr, k) : \
+    lb##N[k] + bo##N)
+
+#define FETCH4(N, R)                                                  \
+   do {                                                               \
+      const GLfloat *s_ = LSRC(N);                                    \
+      if (fl##N & PF_NOSWZ) {                                         \
+         COPY_4V(R, s_);                                              \
+      }                                                               \
+      else {                                                          \
+         (R)[0] = s_[sx##N];                                          \
+         (R)[1] = s_[sy##N];                                          \
+         (R)[2] = s_[sz##N];                                          \
+         (R)[3] = s_[sw##N];                                          \
+      }                                                               \
+      if (fl##N & PF_NEG) {                                           \
+         (R)[0] = -(R)[0];                                            \
+         (R)[1] = -(R)[1];                                            \
+         (R)[2] = -(R)[2];                                            \
+         (R)[3] = -(R)[3];                                            \
+      }                                                               \
+   } while (0)
+
+#define FETCH1(N, R)                                                  \
+   do {                                                               \
+      (R)[0] = LSRC(N)[sx##N];                                        \
+      if (fl##N & PF_NEG)                                             \
+         (R)[0] = -(R)[0];                                            \
+   } while (0)
+
+#define STORE4(V)                                                     \
+   do {                                                               \
+      GLfloat *d_ = unlikely(dslow) ?                                 \
+         lane_dst_pointer(dec, &inst->DstReg, laneAddr, k) :          \
+         lbd[k] + bod;                                                \
+      const GLfloat *v_ = (V);                                        \
+      GLfloat c_[4];                                                  \
+      if (dsat) {                                                     \
+         c_[0] = CLAMP(v_[0], 0.0F, 1.0F);                            \
+         c_[1] = CLAMP(v_[1], 0.0F, 1.0F);                            \
+         c_[2] = CLAMP(v_[2], 0.0F, 1.0F);                            \
+         c_[3] = CLAMP(v_[3], 0.0F, 1.0F);                            \
+         v_ = c_;                                                     \
+      }                                                               \
+      if (wmask & WRITEMASK_X)                                        \
+         d_[0] = v_[0];                                               \
+      if (wmask & WRITEMASK_Y)                                        \
+         d_[1] = v_[1];                                               \
+      if (wmask & WRITEMASK_Z)                                        \
+         d_[2] = v_[2];                                               \
+      if (wmask & WRITEMASK_W)                                        \
+         d_[3] = v_[3];                                               \
+   } while (0)
+
+
+#define FETCH4F(N, R)                                                 \
+   do {                                                               \
+      const GLfloat *s_ = lb##N[k] + bo##N;                           \
+      (R)[0] = s_[sx##N];                                             \
+      (R)[1] = s_[sy##N];                                             \
+      (R)[2] = s_[sz##N];                                             \
+      (R)[3] = s_[sw##N];                                             \
+   } while (0)
+
+#define FETCH1F(N, R)                                                 \
+   ((R)[0] = (lb##N[k] + bo##N)[sx##N])
+
+#define STORE4F(V)                                                    \
+   do {                                                               \
+      GLfloat *d_ = lbd[k] + bod;                                     \
+      const GLfloat *v_ = (V);                                        \
+      if (wmask == WRITEMASK_XYZW) {                                  \
+         d_[0] = v_[0];                                               \
+         d_[1] = v_[1];                                               \
+         d_[2] = v_[2];                                               \
+         d_[3] = v_[3];                                               \
+      }                                                               \
+      else {                                                          \
+         if (wmask & WRITEMASK_X)                                     \
+            d_[0] = v_[0];                                            \
+         if (wmask & WRITEMASK_Y)                                     \
+            d_[1] = v_[1];                                            \
+         if (wmask & WRITEMASK_Z)                                     \
+            d_[2] = v_[2];                                            \
+         if (wmask & WRITEMASK_W)                                     \
+            d_[3] = v_[3];                                            \
+      }                                                               \
+   } while (0)
+
+/* The active lanes, in order: act[0..nact-1]. */
+#define FOR_LANES                                                     \
+   {                                                                  \
+      GLuint j_;                                                      \
+      for (j_ = 0; j_ < nact; j_++) {                                 \
+         const GLuint k = act[j_];
+#define END_LANES                                                     \
+      }                                                               \
+   }
+
+#define SET_EXEC(m)                                                   \
+   do {                                                               \
+      GLuint m_ = (m), b_;                                            \
+      exec = m_;                                                      \
+      nact = 0;                                                       \
+      while (m_) {                                                    \
+         b_ = u_bit_scan(&m_);                                        \
+         act[nact++] = b_;                                            \
+      }                                                               \
+   } while (0)
+
+enum { BS_IF, BS_LOOP };
+
+struct batch_stack_entry {
+   GLuint type;
+   GLuint saved;      /* lanes active before the IF / BGNLOOP */
+   GLuint other;      /* IF: the ELSE lanes; LOOP: lanes that did CONT */
+   GLuint brk;        /* LOOP: lanes that did BRK */
+};
+
+#define MAX_BATCH_STACK 64
+
+
+/**
+ * Can this program be run with _mesa_execute_program_batch()?
+ * (Also decodes it, like _mesa_execute_program.)
+ */
+GLboolean
+_mesa_program_batch_ok(struct gl_program_machine *machine,
+                       const struct gl_program *program)
+{
+   struct prog_decoded *dec;
+
+   if (program->Target == GL_VERTEX_PROGRAM_ARB)
+      return GL_FALSE;
+   if (!machine->DecodedChecked || !machine->Decoded ||
+       machine->Decoded->prog != program ||
+       machine->Decoded->insts != program->arb.Instructions ||
+       machine->Decoded->num != program->arb.NumInstructions)
+      machine->DecodedChecked = decode_program(machine, program);
+   if (!machine->DecodedChecked)
+      return GL_FALSE;
+   dec = machine->Decoded;
+   if (dec->hasCall)
+      return GL_FALSE;
+   if (!dec->btemps) {
+      dec->btemps = malloc(MAX_PROGRAM_TEMPS * PB_LANES * 4 * sizeof(GLfloat));
+      dec->bouts = malloc(MAX_PROGRAM_OUTPUTS * PB_LANES * 4 * sizeof(GLfloat));
+      if (!dec->btemps || !dec->bouts) {
+         free(dec->btemps);
+         free(dec->bouts);
+         dec->btemps = dec->bouts = NULL;
+         return GL_FALSE;
+      }
+      memset(dec->btemps, 0, MAX_PROGRAM_TEMPS * PB_LANES * 4 * sizeof(GLfloat));
+      memset(dec->bouts, 0, MAX_PROGRAM_OUTPUTS * PB_LANES * 4 * sizeof(GLfloat));
+   }
+   return GL_TRUE;
+}
+
+
+/**
+ * Output register 'reg' of lane 'lane' after _mesa_execute_program_batch().
+ */
+const GLfloat *
+_mesa_program_batch_output(const struct gl_program_machine *machine,
+                           GLuint reg, GLuint lane)
+{
+   return machine->Decoded->bouts + (reg * PB_LANES + lane) * 4;
+}
+
+
+/**
+ * Run a fragment program for n (<= PROG_BATCH_LANES) fragments, the
+ * columns cols[0..n-1] of machine->Attribs.  Call
+ * _mesa_program_batch_ok() first.
+ * \\return  -1 if a runaway loop was detected (run the fragments one at a
+ *          time instead, which handles it as before); otherwise a mask
+ *          of the lanes that executed KIL.
+ */
+GLint64
+_mesa_execute_program_batch(struct gl_context *ctx,
+                            const struct gl_program *program,
+                            struct gl_program_machine *machine,
+                            const GLuint *cols, GLuint n)
+{
+   const struct prog_decoded *dec = machine->Decoded;
+   const GLuint numInst = program->arb.NumInstructions;
+   const GLuint maxExec = 65536;
+   GLuint pc, numExec = 0;
+   GLuint exec, dead = 0, fin = 0, nact;
+   GLuint act[PB_LANES];
+   GLint laneAddr[PB_LANES];
+   GLfloat *lb[PB_COUNT][PB_LANES];
+   struct batch_stack_entry stack[MAX_BATCH_STACK];
+   GLuint sp = 0, k0;
+   static GLfloat dummyDst[4];
+
+   assert(n > 0 && n <= PB_LANES);
+   machine->CurProgram = program;
+   machine->EnvParams = ctx->FragmentProgram.Parameters;
+
+   for (k0 = 0; k0 < n; k0++) {
+      lb[PB_ZERO][k0] = (GLfloat *) ZeroVec;   /* only ever read */
+      lb[PB_TEMP][k0] = dec->btemps + k0 * 4;
+      lb[PB_INPUT][k0] = machine->Attribs[0][cols[k0]];
+      lb[PB_OUTPUT][k0] = dec->bouts + k0 * 4;
+      lb[PB_PARAM][k0] = program->Parameters ?
+         (GLfloat *) program->Parameters->ParameterValues : NULL;
+      lb[PB_SYSVAL][k0] = machine->SystemValues[0];
+      lb[PB_DUMMY][k0] = dummyDst;
+      laneAddr[k0] = 0;
+   }
+
+   SET_EXEC(n == PB_LANES ? ~0u : (1u << n) - 1);
+
+   for (pc = 0; pc < numInst; pc++) {
+      const struct prog_instruction *inst = program->arb.Instructions + pc;
+      const struct dec_inst *di = dec->d + pc;
+      PREP_OPS
+
+      switch (inst->Opcode) {
+      case OPCODE_IF:
+         {
+            GLuint cond = 0;
+            if (sp >= MAX_BATCH_STACK)
+               return -1;
+            FOR_LANES {
+               GLfloat a[4];
+               FETCH1(0, a);
+               if (a[0] != 0.0F)
+                  cond |= 1u << k;
+            } END_LANES
+            stack[sp].type = BS_IF;
+            stack[sp].saved = exec;
+            stack[sp].other = exec & ~cond;
+            stack[sp].brk = 0;
+            sp++;
+            SET_EXEC(exec & cond);
+            if (!exec)
+               pc = inst->BranchTarget - 1;   /* to the ELSE or ENDIF */
+         }
+         break;
+      case OPCODE_ELSE:
+         assert(sp > 0 && stack[sp - 1].type == BS_IF);
+         SET_EXEC(stack[sp - 1].other);
+         if (!exec)
+            pc = inst->BranchTarget - 1;      /* to the ENDIF */
+         break;
+      case OPCODE_ENDIF:
+         {
+            GLuint m, i;
+            assert(sp > 0 && stack[sp - 1].type == BS_IF);
+            sp--;
+            m = stack[sp].saved & ~dead & ~fin;
+            /* lanes that left an enclosing loop inside the IF stay off */
+            for (i = sp; i > 0; i--) {
+               if (stack[i - 1].type == BS_LOOP) {
+                  m &= ~(stack[i - 1].brk | stack[i - 1].other);
+                  break;
+               }
+            }
+            SET_EXEC(m);
+         }
+         break;
+      case OPCODE_BGNLOOP:
+         if (sp >= MAX_BATCH_STACK)
+            return -1;
+         stack[sp].type = BS_LOOP;
+         stack[sp].saved = exec;
+         stack[sp].other = 0;
+         stack[sp].brk = 0;
+         sp++;
+         if (!exec)
+            pc = inst->BranchTarget - 1;      /* to the ENDLOOP */
+         break;
+      case OPCODE_BRK:
+      case OPCODE_CONT:
+         {
+            GLuint i;
+            for (i = sp; i > 0; i--) {
+               if (stack[i - 1].type == BS_LOOP) {
+                  if (inst->Opcode == OPCODE_BRK)
+                     stack[i - 1].brk |= exec;
+                  else
+                     stack[i - 1].other |= exec;
+                  break;
+               }
+            }
+            SET_EXEC(0);
+         }
+         break;
+      case OPCODE_ENDLOOP:
+         {
+            struct batch_stack_entry *e;
+            GLuint next;
+            assert(sp > 0 && stack[sp - 1].type == BS_LOOP);
+            e = &stack[sp - 1];
+            next = (exec | e->other) & ~e->brk & ~dead & ~fin;
+            if (next) {
+               e->other = 0;
+               SET_EXEC(next);
+               pc = inst->BranchTarget;       /* after the BGNLOOP */
+               numExec++;                     /* the original steps on it */
+            }
+            else {
+               sp--;
+               SET_EXEC(e->saved & ~dead & ~fin);
+            }
+         }
+         break;
+      case OPCODE_BGNSUB:
+      case OPCODE_ENDSUB:
+      case OPCODE_NOP:
+         break;
+      case OPCODE_CAL:
+         return -1;                           /* not batched */
+      case OPCODE_RET:                        /* return from main */
+         fin |= exec;
+         SET_EXEC(0);
+         break;
+      case OPCODE_END:
+         return dead;
+      case OPCODE_KIL:
+         {
+            GLuint killed = 0;
+            FOR_LANES {
+               GLfloat a[4];
+               FETCH4(0, a);
+               if (a[0] < 0.0F || a[1] < 0.0F || a[2] < 0.0F || a[3] < 0.0F)
+                  killed |= 1u << k;
+            } END_LANES
+            dead |= killed;
+            SET_EXEC(exec & ~killed);
+         }
+         break;
+      /* BEGIN GENERATED by tools/gen-glsl-batch.py from the cases of
+       * _mesa_execute_program() above: edit those, then run the tool.
+       */
+      case OPCODE_ABS:
+         if (!exec) break;
+         if (di->fast) {
+         FOR_LANES {
+         {
+            GLfloat a[4], result[4];
+            FETCH4F(0, a);
+            result[0] = fabsf(a[0]);
+            result[1] = fabsf(a[1]);
+            result[2] = fabsf(a[2]);
+            result[3] = fabsf(a[3]);
+            STORE4F(result);
+         }
+         } END_LANES
+         }
+         else {
+         FOR_LANES {
+         {
+            GLfloat a[4], result[4];
+            FETCH4(0, a);
+            result[0] = fabsf(a[0]);
+            result[1] = fabsf(a[1]);
+            result[2] = fabsf(a[2]);
