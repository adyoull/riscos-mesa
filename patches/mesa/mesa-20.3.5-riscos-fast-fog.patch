                       * perspective-correct rather than start warping
-                      * them under GL_FASTEST.
+                      * them under GL_FASTEST. With fog, the perspective
+                      * triangles, which interpolate the fog coordinate.
                       */
                      USE(persp_textured_triangle);
                   }
