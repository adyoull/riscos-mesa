diff --git a/src/mesa/swrast/s_triangle.c b/src/mesa/swrast/s_triangle.c
index e738160..42e9898 100644
--- a/src/mesa/swrast/s_triangle.c
+++ b/src/mesa/swrast/s_triangle.c
@@ -1346,7 +1346,11 @@ _swrast_choose_triangle( struct gl_context *ctx )
                  (format == MESA_FORMAT_R8G8B8A8_UNORM && UTIL_ARCH_LITTLE_ENDIAN))
              && minFilter == magFilter
              && ctx->Light.Model.ColorControl == GL_SINGLE_COLOR
-             && !swrast->_FogEnabled
+             /* riscos-mesa: fog is allowed: _swrast_write_rgba_span
