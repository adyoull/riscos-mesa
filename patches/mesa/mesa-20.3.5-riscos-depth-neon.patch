+static inline uint32x4_t
+ro_zcmp(GLenum func, uint32x4_t f, uint32x4_t b)
+{
+   switch (func) {
+   case GL_LESS:     return vcltq_u32(f, b);
+   case GL_LEQUAL:   return vcleq_u32(f, b);
+   case GL_GEQUAL:   return vcgeq_u32(f, b);
+   case GL_GREATER:  return vcgtq_u32(f, b);
+   case GL_NOTEQUAL: return vmvnq_u32(vceqq_u32(f, b));
+   case GL_EQUAL:    return vceqq_u32(f, b);
+   default:          return vdupq_n_u32(~0u);   /* GL_ALWAYS */
+   }
+}
