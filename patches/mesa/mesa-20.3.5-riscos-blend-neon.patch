+#if defined(__riscos__) && defined(__arm__) && defined(__ARM_EABI__)
+/*
+ * riscos-mesa: interpolate_int_colors' smooth 8-bit loop with NEON, four
+ * pixels at a time, the same bit for bit: pixel k's colour is the start
+ * colour + k steps (wrapping as the C code's running sums do), shifted
+ * right by FIXED_SHIFT and cut to 8 bits as FixedToChan and the GLubyte
+ * store do. Returns how many pixels it did (a multiple of four), with
+ * the colours advanced past them; the C loop does the rest.
+ */
+#define RO_NEON_SPAN 1
+#pragma GCC push_options
+#pragma GCC target("fpu=neon")
+#include <arm_neon.h>
+
+static GLuint
+ro_neon_int_colors(GLubyte *dst, GLuint n, GLfixed *r, GLfixed *g,
+                   GLfixed *b, GLfixed *a, GLint dr, GLint dg, GLint db,
+                   GLint da)
+{
+   const GLfixed c0[4] = { *r, *g, *b, *a };
+   const GLint st[4] = { dr, dg, db, da };
+   const int32x4_t step = vld1q_s32(st);
+   const int32x4_t step2 = vaddq_s32(step, step);
+   const int32x4_t step4 = vaddq_s32(step2, step2);
+   int32x4_t p0 = vld1q_s32(c0);                /* pixel 0: R G B A */
+   int32x4_t p1 = vaddq_s32(p0, step);
+   int32x4_t p2 = vaddq_s32(p0, step2);
+   int32x4_t p3 = vaddq_s32(p1, step2);
+   GLuint i;
+   for (i = 0; i + 4 <= n; i += 4) {
+      const uint16x8_t lo = vcombine_u16(
+         vmovn_u32(vreinterpretq_u32_s32(vshrq_n_s32(p0, FIXED_SHIFT))),
+         vmovn_u32(vreinterpretq_u32_s32(vshrq_n_s32(p1, FIXED_SHIFT))));
+      const uint16x8_t hi = vcombine_u16(
+         vmovn_u32(vreinterpretq_u32_s32(vshrq_n_s32(p2, FIXED_SHIFT))),
+         vmovn_u32(vreinterpretq_u32_s32(vshrq_n_s32(p3, FIXED_SHIFT))));
+      vst1q_u8(dst + 4 * i, vcombine_u8(vmovn_u16(lo), vmovn_u16(hi)));
+      p0 = vaddq_s32(p0, step4);
+      p1 = vaddq_s32(p1, step4);
+      p2 = vaddq_s32(p2, step4);
+      p3 = vaddq_s32(p3, step4);
+   }
+   *r = vgetq_lane_s32(p0, 0);
+   *g = vgetq_lane_s32(p0, 1);
+   *b = vgetq_lane_s32(p0, 2);
+   *a = vgetq_lane_s32(p0, 3);
+   return i;
+}
+
+/* every pixel the one colour, four pixels a store; returns how many
+ * pixels it did (a multiple of four) */
+static GLuint
+ro_neon_fill_color(GLubyte *dst, GLuint n, const GLubyte color[4])
+{
+   GLuint c32, i;
+   uint8x16_t v;
+   memcpy(&c32, color, 4);
+   v = vreinterpretq_u8_u32(vdupq_n_u32(c32));
+   for (i = 0; i + 4 <= n; i += 4)
+      vst1q_u8(dst + 4 * i, v);
+   return i;
+}
+#pragma GCC pop_options
+#endif
+
