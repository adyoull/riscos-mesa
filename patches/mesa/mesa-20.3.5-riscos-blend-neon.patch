+#if defined(__riscos__) && defined(__arm__) && defined(__ARM_EABI__)
+/*
+ * riscos-mesa: blend_transparency_ubyte with NEON, eight pixels at a time,
+ * the same bit for bit. Each channel is DIV255((s - d) * t) + d, done as
+ * the C code does it ((x * 257 + 256) >> 16, arithmetic shift) in 32-bit
+ * lanes. The C code's special cases need no special handling: t == 0
+ * gives d and t == 255 gives s from the same sums (for every s - d in
+ * [-255, 255]); a pixel whose mask is 0 keeps its colour. A last part
+ * group of eight runs the C code.
+ */
+#define RO_NEON_BLEND 1
+#pragma GCC push_options
+#pragma GCC target("fpu=neon")
+#include <arm_neon.h>
+
+static inline uint8x8_t
+ro_div255_blend8(uint8x8_t s, uint8x8_t d, int16x4_t tlo, int16x4_t thi,
+                 int32x4_t c256, int32x4_t c257)
+{
+   const int16x8_t diff = vreinterpretq_s16_u16(vsubl_u8(s, d));
+   const int32x4_t plo = vmlaq_s32(c256, vmull_s16(vget_low_s16(diff), tlo), c257);
+   const int32x4_t phi = vmlaq_s32(c256, vmull_s16(vget_high_s16(diff), thi), c257);
+   const int16x8_t q = vcombine_s16(vshrn_n_s32(plo, 16), vshrn_n_s32(phi, 16));
+   return vmovn_u16(vreinterpretq_u16_s16(
+      vaddq_s16(q, vreinterpretq_s16_u16(vmovl_u8(d)))));
+}
+
+static void
+blend_transparency_ubyte_neon(struct gl_context *ctx, GLuint n,
+                              const GLubyte mask[], GLvoid *src,
+                              const GLvoid *dst, GLenum chanType)
+{
+   GLubyte *rgba = (GLubyte *) src;
+   const GLubyte *dest = (const GLubyte *) dst;
+   const int32x4_t c256 = vdupq_n_s32(256), c257 = vdupq_n_s32(257);
+   GLuint i;
+
+   for (i = 0; i + 8 <= n; i += 8) {
+      const uint8x8_t m = vld1_u8(mask + i);
+      const uint8x8_t on = vtst_u8(m, m);
+      uint8x8x4_t sv, dv, ov;
+      int16x8_t t;
+      GLuint c;
+      if (!vget_lane_u64(vreinterpret_u64_u8(m), 0))
+         continue;                      /* all eight masked out */
+      sv = vld4_u8(rgba + 4 * i);
+      dv = vld4_u8(dest + 4 * i);
+      t = vreinterpretq_s16_u16(vmovl_u8(sv.val[ACOMP]));
+      for (c = 0; c < 4; c++)
+         ov.val[c] = vbsl_u8(on, ro_div255_blend8(sv.val[c], dv.val[c],
+                                                  vget_low_s16(t),
+                                                  vget_high_s16(t),
+                                                  c256, c257),
+                             sv.val[c]);
+      vst4_u8(rgba + 4 * i, ov);
+   }
+   if (i < n)
+      blend_transparency_ubyte(ctx, n - i, mask + i, rgba + 4 * i,
+                               dest + 4 * i, chanType);
+}
+#pragma GCC pop_options
+#endif
