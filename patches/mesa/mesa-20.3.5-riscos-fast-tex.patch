+/*
+ * riscos-mesa: the wrap modes the fast textured triangles (affine and
+ * perspective) handle, per axis: GL_REPEAT, GL_CLAMP_TO_EDGE, and GL_CLAMP
+ * when filtering with GL_NEAREST (it then picks the same texels as
+ * GL_CLAMP_TO_EDGE; with GL_LINEAR it blends in the border colour at the
+ * edges, which only the general path does). See WRAP_COORD.
+ */
+static inline GLboolean
+fast_tex_wrap(GLenum wrap, GLenum filter)
+{
+   return wrap == GL_REPEAT || wrap == GL_CLAMP_TO_EDGE ||
+          (wrap == GL_CLAMP && filter == GL_NEAREST);
+}
