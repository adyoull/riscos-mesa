+/* riscos-mesa: memcmp(a, b, bytes) == 0 for word-aligned buffers whose
+ * size is a multiple of 4, a word at a time. This check runs for every
+ * span and vertex batch, and UnixLib's memcmp compares a byte at a time
+ * (about 5 instructions a byte), which on RISC OS made it cost as much as
+ * running a short shader on a short span. */
+static inline GLboolean
+words_equal(const void *a, const void *b, size_t bytes)
+{
+   typedef GLuint word_alias __attribute__((may_alias));
+   const word_alias *x = (const word_alias *) a, *y = (const word_alias *) b;
+   size_t n = bytes / 4;
+   while (n >= 2) {
+      if ((x[0] ^ y[0]) | (x[1] ^ y[1]))
+         return GL_FALSE;
+      x += 2;
+      y += 2;
+      n -= 2;
+   }
+   return n == 0 || x[0] == y[0];
+}
+
+typedef char prog_inst_word_sized[(sizeof(struct prog_instruction) % 4 == 0) ? 1 : -1];
+
 static GLboolean
 decoded_matches(const struct prog_decoded *dec, const struct gl_program *prog)
 {
