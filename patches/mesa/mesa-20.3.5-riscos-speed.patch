index 7af764f..4ef7928 100644
--- a/src/mesa/swrast/s_depth.c
+++ b/src/mesa/swrast/s_depth.c
@@ -154,6 +154,55 @@ depth_test_span32( struct gl_context *ctx, GLuint n,
 }
 
 
+/**
+ * RISC OS speed-up: depth test directly on a row of
+ * MESA_FORMAT_Z24_UNORM_X8_UINT values (Z in the low 24 bits), avoiding
+ * the malloc + unpack + shift + pack + free the generic path does for
+ * every span.  The top 8 bits are preserved, as the pack code does.
+ */
+#define Z24_TEST(COMPARE)                                     \
+   do {                                                       \
+      GLuint i;                                               \
+      for (i = 0; i < n; i++) {                               \
+         if (mask[i]) {                                       \
+            const GLuint zb = zbuffer[i] & 0xffffff;          \
+            if (COMPARE) {                                    \
+               if (write)                                     \
+                  zbuffer[i] = (zbuffer[i] & 0xff000000) | zfrag[i]; \
+               passed++;                                      \
+            }                                                 \
+            else {                                            \
+               mask[i] = 0;                                   \
+            }                                                 \
+         }                                                    \
+      }                                                       \
+   } while (0)
+
+static GLuint
+depth_test_span24x8(struct gl_context *ctx, GLuint n,
+                    GLuint zbuffer[], const GLuint zfrag[], GLubyte mask[])
+{
+   const GLboolean write = ctx->Depth.Mask;
+   GLuint passed = 0;
+
+   switch (ctx->Depth.Func) {
+   case GL_LESS:     Z24_TEST(zfrag[i] <  zb); break;
+   case GL_LEQUAL:   Z24_TEST(zfrag[i] <= zb); break;
+   case GL_GEQUAL:   Z24_TEST(zfrag[i] >= zb); break;
+   case GL_GREATER:  Z24_TEST(zfrag[i] >  zb); break;
+   case GL_NOTEQUAL: Z24_TEST(zfrag[i] != zb); break;
+   case GL_EQUAL:    Z24_TEST(zfrag[i] == zb); break;
+   case GL_ALWAYS:   Z24_TEST(((void) zb, 1)); break;
+   case GL_NEVER:
+      memset(mask, 0, n * sizeof(GLubyte));
+      break;
+   default:
+      _mesa_problem(ctx, "Bad depth func in depth_test_span24x8");
+   }
+   return passed;
+}
+
