+/*
+ * riscos-mesa: NEON for the batch interpreter (a test build).
+ *
+ * When every lane of a batch is active, a plain instruction (decode's
+ * "fast": no relative addressing, negation or saturation) with one of the
+ * opcodes below is run for four lanes at a time with NEON, one vector per
+ * component.  The results are the same as the VFP code's: the same IEEE
+ * single-precision operations in the same order (NEON's multiply and add
+ * round like VFP's, and MIN/MAX/CMP/SGE/SLT use the same comparisons as the
+ * C), except that NEON always flushes denormal numbers (below about
+ * 1.2e-38) to zero and gives the default NaN.
+ *
+ * Only used when the CPU has NEON (VFPSupport_Features: MVFR1 says Advanced
+ * SIMD load/store, integer and single precision); other ARMv7 machines run
+ * the C code.  Setting the system variable MESA_NO_NEON turns it off.
+ */
+#if defined(__riscos__) && defined(__arm__) && defined(__ARM_EABI__)
+#define RO_NEON_BATCH 1
+#include <kernel.h>
+#include <swis.h>
+
+static int ro_neon_state = -1;
+
+static GLboolean
+ro_have_neon(void)
+{
+   if (unlikely(ro_neon_state < 0)) {
+      int have = 0;
+      if (!getenv("MESA_NO_NEON")) {
+         _kernel_swi_regs r;
+         r.r[0] = 0;
+         if (_kernel_swi(VFPSupport_Features, &r, &r) == NULL &&
+             (r.r[2] & 0xFFF00) == 0x11100)
+            have = 1;
+      }
+      ro_neon_state = have;
+   }
+   return ro_neon_state;
+}
+
+#pragma GCC push_options
+#pragma GCC target("fpu=neon")
+#include <arm_neon.h>
+
+/* Four lanes' copies of one float: lane i at p + i * 4, or (ls == 0)
+ * the same for every lane */
+static inline float32x4_t
+neon_ld(const GLfloat *p, GLint ls)
+{
+   float32x4_t v;
+   if (!ls)
+      return vld1q_dup_f32(p);
+   v = vld1q_dup_f32(p);
+   v = vld1q_lane_f32(p + 4, v, 1);
+   v = vld1q_lane_f32(p + 8, v, 2);
+   return vld1q_lane_f32(p + 12, v, 3);
+}
+
+/* ... and the store to a destination register: lane i at d + i * 4 */
+static inline void
+neon_st(GLfloat *d, float32x4_t v)
+{
+   vst1q_lane_f32(d, v, 0);
+   vst1q_lane_f32(d + 4, v, 1);
+   vst1q_lane_f32(d + 8, v, 2);
+   vst1q_lane_f32(d + 12, v, 3);
+}
+
+/*
+ * Where NEON and VFP could differ. NEON flushes denormals to zero and
+ * gives the default NaN; VFP (as UnixLib sets it up) keeps denormals and
+ * passes a NaN operand through. So the NEON code checks:
+ *  - each operand: 0 < |x| < 2^-30 (a denormal, or small enough that a
+ *    product or a sum of products could be one). An operand of 0 or at
+ *    least 2^-30 keeps every product and sum these opcodes make a multiple
+ *    of 2^-106 or zero, and so never a denormal;
+ *  - each arithmetic result: NaN.
+ * If any lane hits one, the instruction is run again by the C code (the
+ * destination is never a source: see neon_ok).
+ */
+static inline uint32x4_t
+neon_tiny(float32x4_t x)
+{
+   /* the bits without the sign, minus 1: below 2^-30's, less 1 */
+   const uint32x4_t b = vshlq_n_u32(vreinterpretq_u32_f32(x), 1);
+   return vcltq_u32(vsubq_u32(b, vdupq_n_u32(1)),
+                    vdupq_n_u32((0x30800000u << 1) - 1));
+}
+
+static inline uint32x4_t
+neon_nan(float32x4_t r)
+{
+   return vmvnq_u32(vceqq_f32(r, r));
+}
+
+/* One written component c at a time, for every group of four lanes:
+ * A, B and C are source 0, 1 and 2's component for the lanes, R the
+ * result; CHK is ORed into bad. */
+#define NEON_COMPONENTWISE(NS, EXPR, CHK)                             \
+   for (c = 0; c < 4; c++) {                                          \
+      const GLfloat *p0, *p1, *p2;                                    \
+      GLfloat *d;                                                     \
+      if (!(wmask & (1u << c)))                                       \
+         continue;                                                    \
+      p0 = sp[0] + sw[0][c];                                          \
+      p1 = sp[1] + sw[1][c];                                          \
+      p2 = sp[2] + sw[2][c];                                          \
+      d = d0 + c;                                                     \
+      for (g = 0; g < ng; g++) {                                      \
+         const float32x4_t A = neon_ld(p0, ls[0]);                    \
+         const float32x4_t B = (NS) > 1 ? neon_ld(p1, ls[1]) : A;     \
+         const float32x4_t C = (NS) > 2 ? neon_ld(p2, ls[2]) : A;     \
+         const float32x4_t R = (EXPR);                                \
+         (void) B; (void) C;                                          \
+         bad = vorrq_u32(bad, (CHK));                                 \
+         neon_st(d, R);                                               \
+         p0 += gs[0];                                                 \
+         p1 += gs[1];                                                 \
+         p2 += gs[2];                                                 \
+         d += 16;                                                     \
+      }                                                               \
+   }
+
+#define T1 neon_tiny(A)
+#define T2 vorrq_u32(neon_tiny(A), neon_tiny(B))
+#define T3 vorrq_u32(T2, neon_tiny(C))
+
+/*
+ * Run instructions pc, pc + 1, ... for lanes 0..4*ng-1, all active, while
+ * neon_ok passed for them (and their inputs, if any, are in consecutive
+ * columns: in_cont).
+ * \return  the next instruction to run, times 2, plus 1 if the C code must
+ *          run it (NEON's result could differ from the C's: see above).
+ */
+static GLuint __attribute__((noinline))
+ro_neon_run(const struct gl_program *program, const struct prog_decoded *dec,
+            GLuint pc, GLfloat *(*lb)[PB_LANES], GLuint ng, GLboolean in_cont)
+{
+   const GLuint numInst = program->arb.NumInstructions;
+   const float32x4_t zero = vdupq_n_f32(0.0F), one = vdupq_n_f32(1.0F);
+   const uint32x4_t sign = vdupq_n_u32(0x80000000u);
+
+   do {
+   const struct prog_instruction *inst = program->arb.Instructions + pc;
+   const struct dec_inst *di = dec->d + pc;
+   const GLuint op = inst->Opcode;
+   const GLuint wmask = inst->DstReg.WriteMask & WRITEMASK_XYZW;
+   const GLuint nsrc = di->neon;
+   const GLfloat *sp[3];
+   GLint ls[3], gs[3];
+   const GLubyte *sw[3];
+   GLuint i, g, c;
+   GLfloat *const d0 = lb[di->dst.base][0] + di->dst.boff;
+   uint32x4_t bad = vdupq_n_u32(0);
+   uint32x2_t b2;
+
+   for (i = 0; i < 3; i++) {
+      const struct dec_src *ds = &di->src[i < nsrc ? i : 0];
+      const GLuint b = ds->base;
+      /* lane k at k * 4, or the same for every lane */
+      ls[i] = (b == PB_TEMP || b == PB_OUTPUT || b == PB_INPUT) ? 4 : 0;
+      gs[i] = ls[i] * 4;
+      sp[i] = lb[b][0] + ds->boff;
+      sw[i] = ds->swz;
+   }
+
+   if (op == OPCODE_DP2 || op == OPCODE_DP3 || op == OPCODE_DP4) {
+      /* the C's order: ((a0*b0 + a1*b1) + a2*b2) + a3*b3 */
+      const GLuint nc = op == OPCODE_DP2 ? 2 : op == OPCODE_DP3 ? 3 : 4;
+      for (g = 0; g < ng; g++) {
+         const GLfloat *p0 = sp[0] + g * gs[0], *p1 = sp[1] + g * gs[1];
+         GLfloat *d = d0 + g * 16;
+         float32x4_t s = zero;
+         for (c = 0; c < nc; c++) {
+            const float32x4_t A = neon_ld(p0 + sw[0][c], ls[0]);
+            const float32x4_t B = neon_ld(p1 + sw[1][c], ls[1]);
+            const float32x4_t m = vmulq_f32(A, B);
+            s = c ? vaddq_f32(s, m) : m;
+            bad = vorrq_u32(bad, T2);
+         }
+         bad = vorrq_u32(bad, neon_nan(s));
+         if (wmask == WRITEMASK_XYZW) {
+            float32x4x4_t v;
+            v.val[0] = v.val[1] = v.val[2] = v.val[3] = s;
+            vst4q_f32(d, v);
+         }
+         else {
+            for (c = 0; c < 4; c++)
+               if (wmask & (1u << c))
+                  neon_st(d + c, s);
+         }
+      }
+   }
+   else {
+      switch (op) {
+      case OPCODE_MOV:                             /* the bits */
+         NEON_COMPONENTWISE(1, A, vdupq_n_u32(0));
+         break;
+      case OPCODE_ABS:                             /* the sign bit off */
+         NEON_COMPONENTWISE(1, vreinterpretq_f32_u32(
+                               vbicq_u32(vreinterpretq_u32_f32(A), sign)),
+                            vdupq_n_u32(0));
+         break;
+      case OPCODE_ADD:
+         NEON_COMPONENTWISE(2, vaddq_f32(A, B),
+                            vorrq_u32(T2, neon_nan(R)));
+         break;
+      case OPCODE_SUB:
+         NEON_COMPONENTWISE(2, vsubq_f32(A, B),
+                            vorrq_u32(T2, neon_nan(R)));
+         break;
+      case OPCODE_MUL:
+         NEON_COMPONENTWISE(2, vmulq_f32(A, B),
+                            vorrq_u32(T2, neon_nan(R)));
+         break;
+      case OPCODE_MIN:                             /* a < b ? a : b */
+         NEON_COMPONENTWISE(2, vbslq_f32(vcltq_f32(A, B), A, B), T2);
+         break;
+      case OPCODE_MAX:                             /* a > b ? a : b */
+         NEON_COMPONENTWISE(2, vbslq_f32(vcgtq_f32(A, B), A, B), T2);
+         break;
+      case OPCODE_SGE:
+         NEON_COMPONENTWISE(2, vbslq_f32(vcgeq_f32(A, B), one, zero), T2);
+         break;
+      case OPCODE_SLT:
+         NEON_COMPONENTWISE(2, vbslq_f32(vcltq_f32(A, B), one, zero), T2);
+         break;
+      case OPCODE_MAD:                             /* a * b + c */
+         NEON_COMPONENTWISE(3, vaddq_f32(vmulq_f32(A, B), C),
+                            vorrq_u32(T3, neon_nan(R)));
+         break;
+      case OPCODE_CMP:                             /* a < 0 ? b : c */
+         NEON_COMPONENTWISE(3, vbslq_f32(vcltq_f32(A, zero), B, C), T1);
+         break;
+      case OPCODE_LRP:                             /* a * b + (1 - a) * c */
+         NEON_COMPONENTWISE(3, vaddq_f32(vmulq_f32(A, B),
+                                         vmulq_f32(vsubq_f32(one, A), C)),
+                            vorrq_u32(T3, neon_nan(R)));
+         break;
+      default:
+         unreachable("checked by neon_ok");
+      }
+   }
+   b2 = vorr_u32(vget_low_u32(bad), vget_high_u32(bad));
+   if (vget_lane_u32(vpmax_u32(b2, b2), 0))
+      return pc * 2 + 1;               /* the C code runs it again */
+   pc++;
+   } while (pc < numInst && dec->d[pc].neon &&
+            (in_cont || !dec->d[pc].neon_in));
+   return pc * 2;
+}
+#undef NEON_COMPONENTWISE
+#undef T1
+#undef T2
+#undef T3
+#pragma GCC pop_options
+#endif /* RO_NEON_BATCH */
+
