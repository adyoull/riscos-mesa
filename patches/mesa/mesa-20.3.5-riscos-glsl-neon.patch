+/*
+ * riscos-mesa: can the batch executor's NEON code (ro_neon_inst) run this
+ * fast instruction? Its opcode is one it has, the destination a temporary
+ * or output, and every source a temporary, input, parameter, system value
+ * or zero; and the destination isn't a source (but see below).
+ * \return  the number of sources, or 0 if not.
+ */
+static GLubyte
+neon_ok(const struct prog_instruction *inst, const struct dec_inst *di,
+        GLubyte *reads_input)
+{
+   const GLuint wmask = inst->DstReg.WriteMask & WRITEMASK_XYZW;
+   GLboolean dot = GL_FALSE, overlap = GL_FALSE;
+   GLuint nsrc, k;
+
+   switch (inst->Opcode) {
+   case OPCODE_ABS: case OPCODE_MOV:
+      nsrc = 1; break;
+   case OPCODE_DP2: case OPCODE_DP3: case OPCODE_DP4:
+      dot = GL_TRUE;
+      /* fall through */
+   case OPCODE_ADD: case OPCODE_SUB: case OPCODE_MUL: case OPCODE_MIN:
+   case OPCODE_MAX: case OPCODE_SGE: case OPCODE_SLT:
+      nsrc = 2; break;
+   case OPCODE_MAD: case OPCODE_CMP: case OPCODE_LRP:
+      nsrc = 3; break;
+   default:
+      return GL_FALSE;
+   }
+   if (!di->fast || !wmask ||
+       (di->dst.base != PB_TEMP && di->dst.base != PB_OUTPUT))
+      return GL_FALSE;
+   *reads_input = 0;
+   for (k = 0; k < nsrc; k++) {
+      const struct dec_src *ds = &di->src[k];
+      switch (ds->base) {
+      case PB_INPUT:
+         *reads_input = 1;
+         break;
+      case PB_TEMP: case PB_OUTPUT: case PB_PARAM: case PB_SYSVAL:
+      case PB_ZERO:
+         break;
+      default:
+         return GL_FALSE;
+      }
+      if (ds->base == di->dst.base && ds->boff == di->dst.boff)
+         overlap = GL_TRUE;
+   }
+   /* NEON may hand an instruction back to the C code after storing its
+    * results (ro_neon_run), so its sources mustn't include the
+    * destination; MOV and ABS never are, and run a component at a time */
+   if (overlap && (dot || (inst->Opcode != OPCODE_MOV &&
+                           inst->Opcode != OPCODE_ABS) ||
+                   (wmask & (wmask - 1))))
+      return 0;
+   return nsrc;
+}
