@@ -58,9 +58,17 @@
 
 /**
  * Max image/surface/texture size.
+ *
+ * riscos-mesa: 4096 instead of 16384. Each context's span buffers are
+ * sized by the width (SWspanarrays alone is 64 x width x 16 bytes, 16 MB
+ * at 16384), and on RISC OS all of it is committed in the application
+ * slot. 4096 x 4096 covers every Raspberry Pi screen mode up to 4K and
+ * matches riscos-mesa's EGL pbuffer limit. The OSMesa driver reports it
+ * as the largest viewport, renderbuffer and texture (set_size_limits in
+ * osmesa.c). PROG_MAX_WIDTH in program/prog_execute.h must match.
  */
-#define SWRAST_MAX_WIDTH 16384
-#define SWRAST_MAX_HEIGHT 16384
+#define SWRAST_MAX_WIDTH 4096
+#define SWRAST_MAX_HEIGHT 4096
 
 
