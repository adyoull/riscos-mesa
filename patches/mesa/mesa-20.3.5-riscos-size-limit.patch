index ada8a34..0993d2b 100644
--- a/src/mesa/drivers/osmesa/osmesa.c
+++ b/src/mesa/drivers/osmesa/osmesa.c
@@ -59,6 +59,7 @@
 #include "drivers/common/driverfuncs.h"
 #include "drivers/common/meta.h"
 #include "vbo/vbo.h"
+#include "util/u_math.h"
 #include "util/u_memory.h"
 
 
@@ -780,6 +781,29 @@ osmesa_UnmapRenderbuffer(struct gl_context *ctx, struct gl_renderbuffer *rb)
 }
 
 
+/**
+ * riscos-mesa: report swrast's size limits (SWRAST_MAX_WIDTH/HEIGHT,
+ * lowered to 4096 in swrast.h) as this context's largest viewport,
+ * renderbuffer and texture. Mesa's defaults are 16384, which would let a
+ * program ask for images wider than swrast's span buffers.
+ */
+static void
+set_size_limits(struct gl_context *ctx)
+{
+   const unsigned levels = util_logbase2(SWRAST_MAX_WIDTH) + 1;
+
+   ctx->Const.MaxViewportWidth = SWRAST_MAX_WIDTH;
+   ctx->Const.MaxViewportHeight = SWRAST_MAX_HEIGHT;
+   ctx->Const.MaxRenderbufferSize = MIN2(SWRAST_MAX_WIDTH, SWRAST_MAX_HEIGHT);
+   ctx->Const.MaxTextureSize = MIN2(ctx->Const.MaxTextureSize, SWRAST_MAX_WIDTH);
+   ctx->Const.MaxTextureRectSize = MIN2(ctx->Const.MaxTextureRectSize,
+                                        SWRAST_MAX_WIDTH);
+   ctx->Const.Max3DTextureLevels = MIN2(ctx->Const.Max3DTextureLevels, levels);
+   ctx->Const.MaxCubeTextureLevels = MIN2(ctx->Const.MaxCubeTextureLevels,
+                                          levels);
+}
+
+
 /**********************************************************************/
 /*****                    Public Functions                        *****/
 /**********************************************************************/
@@ -1014,6 +1038,7 @@ OSMesaCreateContextAttribs(const int *attribList, OSMesaContext sharelist)
          return NULL;
       }
 
+      set_size_limits(&osmesa->mesa);
       _mesa_enable_sw_extensions(&(osmesa->mesa));
 
       osmesa->gl_buffer = _mesa_create_framebuffer(osmesa->gl_visual);
