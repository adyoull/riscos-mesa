  * span->interpMask and span->arrayMask may be changed but will be restored
  * to their original values before returning.
  */
+/**
+ * riscos-mesa: _swrast_write_rgba_span for the commonest span of 3D
+ * games, a horizontal run of shaded (or textured, by the fast textured
+ * triangles) pixels, depth-tested, inside the window and scissor box, and
+ * written to one 8-bit colour buffer, perhaps fogged and blended. It does
+ * what _swrast_write_rgba_span does for such a span, in the same order,
+ * skipping the general function's checks and steps that don't apply (each
+ * of which would leave the span as it is). Returns GL_FALSE, having done
+ * nothing, for any other span.
+ */
+static GLboolean
+ro_write_rgba_span_fast(struct gl_context *ctx, SWspan *span)
+{
+   const SWcontext *swrast = SWRAST_CONTEXT(ctx);
+   struct gl_framebuffer *fb = ctx->DrawBuffer;
+   const struct gl_program *fp = ctx->FragmentProgram._Current;
+   struct gl_renderbuffer *rb;
+   GLbitfield origInterpMask, origArrayMask;
+   GLbitfield64 origArrayAttribs;
+   GLenum origChanType;
+   void *origRgba;
+
+   /* (the commonest reasons not to first) */
+   if (!ctx->Depth.Test || ctx->Texture._EnabledCoordUnits ||
+       (fp && !(fp == ctx->FragmentProgram._TexEnvProgram &&
+                fp->arb.NumInstructions == 0)))
+      return GL_FALSE;
+   /* the span */
+   if (span->primitive != GL_POLYGON ||
+       (span->arrayMask & (SPAN_MASK | SPAN_XY | SPAN_COVERAGE)) ||
+       span->array->ChanType != GL_UNSIGNED_BYTE ||
+       span->y < fb->_Ymin || span->y >= fb->_Ymax ||
+       span->x < fb->_Xmin || span->x + (GLint) span->end > fb->_Xmax)
+      return GL_FALSE;
+   /* fragment processing: no shading or texturing here (the fast textured
+    * triangles have done the texturing), a depth test and nothing else
+    * before the colour is written but fog and blending */
+   if (_mesa_ati_fragment_shader_enabled(ctx) ||
+       fb->Visual.depthBits == 0 ||
+       ctx->Depth.BoundsTest ||
+       (ctx->Transform.DepthClampNear && ctx->Transform.DepthClampFar) ||
+       _mesa_stencil_is_enabled(ctx) ||
+       ctx->Polygon.StippleFlag ||
+       ctx->Color.AlphaEnabled ||
+       ctx->Query.CurrentOcclusionObject ||
+       ctx->Fog.ColorSumEnabled ||
+       (ctx->Light.Enabled &&
+        ctx->Light.Model.ColorControl == GL_SEPARATE_SPECULAR_COLOR) ||
+       ctx->Color.ColorLogicOpEnabled)
+      return GL_FALSE;
+   /* one 8-bit colour buffer, all channels written */
+   if (fb->_NumColorDrawBuffers != 1 ||
+       !(rb = fb->_ColorDrawBuffers[0]) ||
+       swrast_renderbuffer(rb)->ColorType != GL_UNSIGNED_BYTE ||
+       GET_COLORMASK(ctx->Color.ColorMask, 0) != 0xf)
+      return GL_FALSE;
+
+   origInterpMask = span->interpMask;
+   origArrayMask = span->arrayMask;
+   origArrayAttribs = span->arrayAttribs;
+   origChanType = span->array->ChanType;
+   origRgba = span->array->rgba;
+
+   memset(span->array->mask, 1, span->end);
+   span->writeAll = GL_TRUE;
+   span->leftClip = 0;        /* as clip_span, for a span inside */
+
+   if (!(span->arrayMask & SPAN_Z))
+      _swrast_span_interpolate_z(ctx, span);
+   if (_swrast_depth_test_span(ctx, span)) {
+      if (!(span->arrayMask & SPAN_RGBA))
+         interpolate_int_colors(ctx, span);
+      if (swrast->_FogEnabled)
+         _swrast_fog_rgba_span(ctx, span);
+      span->array->rgba = span->array->rgba8;
+      if (ctx->Color.BlendEnabled & 1)
+         _swrast_blend_span(ctx, rb, span);
+      _swrast_put_row(ctx, rb, span->array->ChanType, span->end,
+                      span->x, span->y, span->array->rgba,
+                      span->writeAll ? NULL : span->array->mask);
+   }
+
+   span->interpMask = origInterpMask;
+   span->arrayMask = origArrayMask;
+   span->arrayAttribs = origArrayAttribs;
+   span->array->ChanType = origChanType;
+   span->array->rgba = origRgba;
+   return GL_TRUE;
+}
+
+
 void
 _swrast_write_rgba_span( struct gl_context *ctx, SWspan *span)
 {
+   /* riscos-mesa */
+   if (ro_write_rgba_span_fast(ctx, span))
+      return;
+
    const SWcontext *swrast = SWRAST_CONTEXT(ctx);
    const GLbitfield origInterpMask = span->interpMask;
    const GLbitfield origArrayMask = span->arrayMask;
