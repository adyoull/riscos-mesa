OSMesa: a 16-bit format in RISC OS's 5:6:5 order (2026-11-23)

- include/GL/osmesa.h, drivers/osmesa/osmesa.c: OSMESA_RGB_565_RISCOS,
  16-bit pixels with red in bits 0-4 and blue in 11-15, as RISC OS's 5:6:5
  sprites (type 10) and C64K screens (Mesa's MESA_FORMAT_R5G6B5_UNORM;
  OSMESA_RGB_565 has red at the top). For contexts (OSMESA_FORMAT),
  OSMesaMakeCurrent (type GL_UNSIGNED_SHORT_5_6_5) and OSMesaBuffers, whose
  rows are then 2 bytes a pixel. EGL's 16-bit configs draw with it.
  OSMesa's own fast lines and triangles stay 32-bit only, as before.

--- a/include/GL/osmesa.h
+++ b/include/GL/osmesa.h
@@ -113,6 +113,11 @@
 /* riscos-mesa: OSMesaCreateContextAttribs: a non-zero value always draws
    in software, never through RISC3D (EGL's own contexts use it) */
 #define OSMESA_SOFTWARE_RISCOS       0x7F00
+/* riscos-mesa: a format: 16-bit pixels with red in bits 0-4, green in 5-10
+   and blue in 11-15, as RISC OS's 5:6:5 (sprite type 10, a C64K mode).
+   (OSMESA_RGB_565 has red at the top.) Through OSMesaMakeCurrent the type
+   is GL_UNSIGNED_SHORT_5_6_5. */
+#define OSMESA_RGB_565_RISCOS        0x7F01
 
 
 typedef struct osmesa_context *OSMesaContext;
@@ -368,7 +373,7 @@
  *
  * An OSMesaBuffer is a drawable of its own: its colour buffer is memory
  * the caller supplies (32-bit OSMESA_RGBA or OSMESA_BGRA pixels, as
- * GL_UNSIGNED_BYTE), and its depth and stencil buffers belong to it rather
+ * GL_UNSIGNED_BYTE, or 16-bit OSMESA_RGB_565_RISCOS), and its depth and stencil buffers belong to it rather
  * than to a context. So several contexts drawing into it in turn share its
  * depth buffer, as EGL requires, and a context can draw into one buffer
  * and read (glReadPixels, glCopyTexImage...) from another.
--- a/src/mesa/drivers/osmesa/osmesa.c
+++ b/src/mesa/drivers/osmesa/osmesa.c
@@ -739,6 +739,9 @@
       assert(osmesa->DataType == GL_UNSIGNED_BYTE);
       rb->Format = MESA_FORMAT_B5G6R5_UNORM;
    }
+   else if (osmesa->format == OSMESA_RGB_565_RISCOS) {
+      rb->Format = MESA_FORMAT_R5G6B5_UNORM;    /* riscos-mesa: red in bits 0-4 */
+   }
    else {
       _mesa_problem(ctx, "bad pixel format in osmesa renderbuffer_storage");
    }
@@ -791,7 +794,8 @@
    if (rb->ClassID == OSMESA_BUFFER_RB_CLASS) {
       /* riscos-mesa: an OSMesaBuffer's colour: its own row length and order */
