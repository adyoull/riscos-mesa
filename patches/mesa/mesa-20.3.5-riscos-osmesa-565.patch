-      *mapOut = (GLubyte *) brb->Base.Buffer + y * rowStride + x * 4;
+      *mapOut = (GLubyte *) brb->Base.Buffer + y * rowStride + x * bpp;
    }
    else if (rb->ClassID == OSMESA_RENDERBUFFER_CLASS) {
       /* this is an OSMesa renderbuffer which wraps user memory */
@@ -1007,6 +1011,7 @@
          case OSMESA_RGB:
          case OSMESA_BGR:
          case OSMESA_RGB_565:
+         case OSMESA_RGB_565_RISCOS:
