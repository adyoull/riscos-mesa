-      const GLint rowStride = brb->RowLength * 4;
+      const GLint bpp = brb->Format == OSMESA_RGB_565_RISCOS ? 2 : 4;
+      const GLint rowStride = brb->RowLength * bpp;
 
       if (!brb->YUp) {
          y = rb->Height - y - 1;
@@ -800,7 +804,7 @@
       else {
          *rowStrideOut = rowStride;
