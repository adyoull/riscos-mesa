+/*
+ * riscos-mesa: OSMesa contexts drawn by RISC3D, a hardware path, where it
+ * has a driver (riscos-mesa's osmesa/risc3d_route.c, which libOSMesa
+ * contains on RISC OS). These are the hooks osmesa.c calls. Elsewhere
+ * (the build machine's own libOSMesa, for riscos-mesa's tests) they are
+ * weak: absent unless the program defines them, and then OSMesa draws in
+ * software as always.
+ */
+#ifndef OSMESA_RISCOS_H
+#define OSMESA_RISCOS_H
+
+#if defined(__riscos__)
+#define OSMESA_R3D_HOOK
+#define OSMESA_R3D_HAVE(f) 1
+#else
+#define OSMESA_R3D_HOOK __attribute__((weak))
+#define OSMESA_R3D_HAVE(f) ((f) != NULL)
+#endif
+
+/* After a software context is made: also make a RISC3D one for it if the
+   choice of renderer (riscos_mesa_pick_renderer) says so. */
+OSMESA_R3D_HOOK void osmesa_r3d_create(OSMesaContext o, int profile, int major, int minor,
+                                       GLenum format, int accum_bits);
+OSMESA_R3D_HOOK void osmesa_r3d_destroy(OSMesaContext o);
+/* OSMesaMakeCurrent: 1 if o now draws through RISC3D into buffer; 0 if
+   it draws in software (or o is NULL), with RISC3D's drawing let go of */
+OSMESA_R3D_HOOK int osmesa_r3d_make_current(OSMesaContext o, void *buffer, GLenum type,
+                                            int width, int height, GLenum format,
+                                            int row_length, int y_up);
+OSMESA_R3D_HOOK OSMesaContext osmesa_r3d_current(void);
+/* for the context current through RISC3D: OSMesaPixelStore's changes,
+   and what OSMesaGetIntegerv, OSMesaGetColorBuffer and
+   OSMesaGetDepthBuffer answer (1: answered) */
+OSMESA_R3D_HOOK void osmesa_r3d_retarget(OSMesaContext o, int row_length, int y_up);
+OSMESA_R3D_HOOK int osmesa_r3d_size(OSMesaContext o, int *width, int *height);
+OSMESA_R3D_HOOK int osmesa_r3d_color_buffer(OSMesaContext o, int *width, int *height, void **buffer);
+OSMESA_R3D_HOOK int osmesa_r3d_depth_buffer(OSMesaContext o, int *width, int *height,
+                                            int *bytes_per_value, void **buffer);
+
+#endif
