+/* the alpha test (ALPHA_TEST's comparisons, on the 8-bit alphas of rgba)
+ * sixteen fragments at a time, then eight: mask[i] &= (alpha FUNC ref), the mask
+ * being 0 or 1. *all is cleared if a fragment's mask ends up 0, *any set
+ * if one's ends up 1. Returns how many it did (a multiple of 8). */
+static GLuint
+ro_neon_alpha_test(const GLubyte *rgba, GLubyte *mask, GLuint n,
+                   GLenum func, GLubyte ref, GLboolean *all, GLboolean *any)
+{
+   const uint8x16_t r = vdupq_n_u8(ref), one = vdupq_n_u8(1);
+   uint8x16_t acc_and = one, acc_or = vdupq_n_u8(0);
+   uint8x8_t lo, hi;
+   GLuint i;
+   for (i = 0; i + 16 <= n; i += 16) {
+      const uint8x16_t a = vld4q_u8(rgba + 4 * i).val[ACOMP];
+      uint8x16_t c, m;
+      switch (func) {
+      case GL_LESS:     c = vcltq_u8(a, r); break;
+      case GL_LEQUAL:   c = vcleq_u8(a, r); break;
+      case GL_GEQUAL:   c = vcgeq_u8(a, r); break;
+      case GL_GREATER:  c = vcgtq_u8(a, r); break;
+      case GL_NOTEQUAL: c = vmvnq_u8(vceqq_u8(a, r)); break;
+      default:          c = vceqq_u8(a, r); break;   /* GL_EQUAL */
+      }
+      m = vandq_u8(vld1q_u8(mask + i), vandq_u8(c, one));
+      vst1q_u8(mask + i, m);
+      acc_and = vandq_u8(acc_and, m);
+      acc_or = vorrq_u8(acc_or, m);
+   }
+   lo = vand_u8(vget_low_u8(acc_and), vget_high_u8(acc_and));
+   hi = vorr_u8(vget_low_u8(acc_or), vget_high_u8(acc_or));
+   if (i + 8 <= n) {                    /* then eight */
+      const uint8x8_t a = vld4_u8(rgba + 4 * i).val[ACOMP];
+      const uint8x8_t r8 = vget_low_u8(r);
+      uint8x8_t c, m;
+      switch (func) {
+      case GL_LESS:     c = vclt_u8(a, r8); break;
+      case GL_LEQUAL:   c = vcle_u8(a, r8); break;
+      case GL_GEQUAL:   c = vcge_u8(a, r8); break;
+      case GL_GREATER:  c = vcgt_u8(a, r8); break;
+      case GL_NOTEQUAL: c = vmvn_u8(vceq_u8(a, r8)); break;
+      default:          c = vceq_u8(a, r8); break;
+      }
+      m = vand_u8(vld1_u8(mask + i), vand_u8(c, vget_low_u8(one)));
+      vst1_u8(mask + i, m);
+      lo = vand_u8(lo, m);
+      hi = vorr_u8(hi, m);
+      i += 8;
+   }
+   /* AND / OR of 0s and 1s: the smallest / largest lane */
+   lo = vpmin_u8(lo, lo); lo = vpmin_u8(lo, lo); lo = vpmin_u8(lo, lo);
+   hi = vpmax_u8(hi, hi); hi = vpmax_u8(hi, hi); hi = vpmax_u8(hi, hi);
+   if (i) {
+      if (!vget_lane_u8(lo, 0))
+         *all = GL_FALSE;
+      if (vget_lane_u8(hi, 0))
+         *any = GL_TRUE;
+   }
+   return i;
+}
+
+/* whether every fragment of the first n with its mask set has alpha 255,
+ * sixteen at a time, then eight; *done: how many it looked at (a
+ * multiple of 8) */
+static GLboolean
+ro_neon_opaque(const GLubyte *rgba, const GLubyte *mask, GLuint n, GLuint *done)
+{
+   GLuint i;
+   for (i = 0; i + 16 <= n; i += 16) {
+      const uint8x16_t a = vld4q_u8(rgba + 4 * i).val[ACOMP];
+      /* 255 where the alpha is 255 or the fragment is masked out */
+      const uint8x16_t ok = vorrq_u8(vceqq_u8(a, vdupq_n_u8(255)),
+                                     vceqq_u8(vld1q_u8(mask + i), vdupq_n_u8(0)));
+      uint8x8_t v = vand_u8(vget_low_u8(ok), vget_high_u8(ok));
+      if (vget_lane_u64(vreinterpret_u64_u8(v), 0) != ~(uint64_t) 0) {
+         *done = i;
+         return GL_FALSE;
+      }
+   }
+   if (i + 8 <= n) {                    /* then eight */
+      const uint8x8_t a = vld4_u8(rgba + 4 * i).val[ACOMP];
+      const uint8x8_t ok = vorr_u8(vceq_u8(a, vdup_n_u8(255)),
+                                   vceq_u8(vld1_u8(mask + i), vdup_n_u8(0)));
+      if (vget_lane_u64(vreinterpret_u64_u8(ok), 0) != ~(uint64_t) 0) {
+         *done = i;
+         return GL_FALSE;
+      }
+      i += 8;
+   }
+   *done = i;
+   return GL_TRUE;
+}
 #pragma GCC pop_options
 #endif
 
