+/* riscos-mesa: ro_fog_pixel for eight pixels with NEON, the factors
+ * f0 + k * df (k = 0..7, as the C loop's running sum gives them) >> 8,
+ * the same bit for bit: each of red, green and blue is
+ * (c * f + fog * (256 - f)) >> 8, which ro_fog_pixel's packed sums come
+ * to (no sum reaches 65536, so there are no carries between channels and
+ * the masks change nothing), worked out in 16-bit lanes; alpha is kept */
+#define RO_NEON_FOG 1
+#pragma GCC push_options
+#pragma GCC target("fpu=neon")
+#include <arm_neon.h>
+static void
+ro_neon_fog8(GLubyte *px, GLint f0, GLint df, GLuint fogR, GLuint fogG,
+             GLuint fogB)
+{
+   static const int32_t k4[4] = { 0, 1, 2, 3 };
+   const int32x4_t k = vld1q_s32(k4);
+   const int32x4_t flo = vaddq_s32(vdupq_n_s32(f0), vmulq_n_s32(k, df));
+   const int32x4_t fhi = vaddq_s32(flo, vdupq_n_s32(4 * df));
+   const uint16x8_t f = vcombine_u16(
+      vmovn_u32(vshrq_n_u32(vreinterpretq_u32_s32(flo), 8)),
+      vmovn_u32(vshrq_n_u32(vreinterpretq_u32_s32(fhi), 8)));
+   const uint16x8_t nf = vsubq_u16(vdupq_n_u16(256), f);
+   uint8x8x4_t p = vld4_u8(px);
+   p.val[0] = vshrn_n_u16(vmlaq_u16(vmulq_u16(vmovl_u8(p.val[0]), f),
+                                    vdupq_n_u16((uint16_t) fogR), nf), 8);
+   p.val[1] = vshrn_n_u16(vmlaq_u16(vmulq_u16(vmovl_u8(p.val[1]), f),
+                                    vdupq_n_u16((uint16_t) fogG), nf), 8);
+   p.val[2] = vshrn_n_u16(vmlaq_u16(vmulq_u16(vmovl_u8(p.val[2]), f),
+                                    vdupq_n_u16((uint16_t) fogB), nf), 8);
+   vst4_u8(px, p);
+}
+#pragma GCC pop_options
+#endif
