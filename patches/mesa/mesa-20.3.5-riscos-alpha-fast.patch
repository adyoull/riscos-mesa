+/* riscos-mesa: _swrast_alpha_test for the fast route. For 8-bit colours
+ * in the span's array (textured spans) it does the same comparisons
+ * (with NEON when there is NEON) and returns 0 when no fragment passes,
+ * 2 when all do (leaving span->writeAll as it is: the same pixels are
+ * written either way) and 1 otherwise, clearing writeAll; anything else
+ * goes to _swrast_alpha_test (1, or 0 for GL_NEVER). */
+static int
+ro_alpha_test_fast(const struct gl_context *ctx, SWspan *span)
+{
+   GLubyte (*rgba)[4] = span->array->rgba8;
+   GLubyte *mask = span->array->mask;
+   const GLuint n = span->end;
+   const GLenum func = ctx->Color.AlphaFunc;
+   GLboolean all = GL_TRUE, any = GL_FALSE;
+   GLubyte ref;
+   GLuint i = 0;
+
+   if (!(span->arrayMask & SPAN_RGBA) ||
+       span->array->ChanType != GL_UNSIGNED_BYTE ||
+       func == GL_ALWAYS || func == GL_NEVER ||
+       (func != GL_LESS && func != GL_LEQUAL && func != GL_GEQUAL &&
+        func != GL_GREATER && func != GL_NOTEQUAL && func != GL_EQUAL))
+      return _swrast_alpha_test(ctx, span);
+   CLAMPED_FLOAT_TO_UBYTE(ref, ctx->Color.AlphaRef);
+#ifdef RO_NEON_SPAN
+   if (_mesa_ro_have_neon())
+      i = ro_neon_alpha_test(&rgba[0][0], mask, n, func, ref, &all, &any);
+#endif
+   for (; i < n; i++) {
+      const GLubyte a = rgba[i][ACOMP];
+      GLubyte pass;
+      switch (func) {
+      case GL_LESS:     pass = a < ref; break;
+      case GL_LEQUAL:   pass = a <= ref; break;
+      case GL_GEQUAL:   pass = a >= ref; break;
+      case GL_GREATER:  pass = a > ref; break;
+      case GL_NOTEQUAL: pass = a != ref; break;
+      default:          pass = a == ref; break;
+      }
+      mask[i] &= pass;
+      if (mask[i])
+         any = GL_TRUE;
+      else
+         all = GL_FALSE;
+   }
+   if (all)
+      return 2;
+   span->writeAll = GL_FALSE;
+   return any;
+}
