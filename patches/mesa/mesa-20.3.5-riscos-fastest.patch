+/*
+ * riscos-mesa: the texture image and filter the fast textured triangles
+ * sample. Normally the base image, and the sampler's filter (the fast
+ * triangles are then only used when the minification and magnification
+ * filters are the same).
+ *
+ * Under GL_PERSPECTIVE_CORRECTION_HINT GL_FASTEST they are also used
+ * with other filters, mipmaps included, and choose one image and filter
+ * for the whole triangle. The level of detail is worked out as the
+ * general path does per pixel (log2 of the longer of the texel steps per
+ * pixel in x and in y), from the triangle's texture coordinate gradients:
+ * magnified, the base image with the magnification filter; minified, the
+ * nearest mipmap level with the minification filter's filtering within a
+ * level. The general path chooses per pixel and blends two levels for
+ * *_MIPMAP_LINEAR, so this is only right where a triangle's scale doesn't
+ * change much across it, which is what the hint allows.
+ */
+static const struct gl_texture_image *
+fast_tex_image(struct gl_context *ctx, const struct gl_texture_object *obj,
+               const SWvertex *v0, const SWvertex *v1, const SWvertex *v2,
+               GLenum *filter)
+{
+   const struct gl_sampler_object *samp = _mesa_get_samplerobj(ctx, 0);
+   const struct gl_texture_image *base = _mesa_base_tex_image(obj);
+   const GLfloat *t0 = v0->attrib[VARYING_SLOT_TEX0];
+   const GLfloat *t1 = v1->attrib[VARYING_SLOT_TEX0];
+   const GLfloat *t2 = v2->attrib[VARYING_SLOT_TEX0];
+   const GLfloat *p0 = v0->attrib[VARYING_SLOT_POS];
+   const GLfloat *p1 = v1->attrib[VARYING_SLOT_POS];
+   const GLfloat *p2 = v2->attrib[VARYING_SLOT_POS];
+   GLfloat s[3], t[3], det, dsdx, dsdy, dtdx, dtdy, rho, lod;
+   GLint level;
+
+   *filter = samp->MinFilter;
+   if (ctx->Hint.PerspectiveCorrection != GL_FASTEST ||
+       samp->MinFilter == samp->MagFilter)
+      return base;
+
+   /* texture coordinates in base level texels (s/q, t/q) */
+   s[0] = t0[0] / (t0[3] ? t0[3] : 1.0F) * base->Width;
+   t[0] = t0[1] / (t0[3] ? t0[3] : 1.0F) * base->Height;
+   s[1] = t1[0] / (t1[3] ? t1[3] : 1.0F) * base->Width;
+   t[1] = t1[1] / (t1[3] ? t1[3] : 1.0F) * base->Height;
+   s[2] = t2[0] / (t2[3] ? t2[3] : 1.0F) * base->Width;
+   t[2] = t2[1] / (t2[3] ? t2[3] : 1.0F) * base->Height;
+   /* d(s,t)/d(x,y) across the triangle */
+   det = (p1[0] - p0[0]) * (p2[1] - p0[1]) - (p2[0] - p0[0]) * (p1[1] - p0[1]);
+   if (det == 0.0F)
+      return base;
+   dsdx = ((s[1] - s[0]) * (p2[1] - p0[1]) - (s[2] - s[0]) * (p1[1] - p0[1])) / det;
+   dtdx = ((t[1] - t[0]) * (p2[1] - p0[1]) - (t[2] - t[0]) * (p1[1] - p0[1])) / det;
+   dsdy = ((s[2] - s[0]) * (p1[0] - p0[0]) - (s[1] - s[0]) * (p2[0] - p0[0])) / det;
+   dtdy = ((t[2] - t[0]) * (p1[0] - p0[0]) - (t[1] - t[0]) * (p2[0] - p0[0])) / det;
+   rho = MAX2(sqrtf(dsdx * dsdx + dtdx * dtdx), sqrtf(dsdy * dsdy + dtdy * dtdy));
+   lod = rho > 0.0F ? log2f(rho) : 0.0F;
+   lod += samp->LodBias + ctx->Texture.Unit[0].LodBias;
+
+   if (lod <= 0.0F) {
+      *filter = samp->MagFilter;
+      return base;
+   }
+   switch (samp->MinFilter) {
+   case GL_NEAREST_MIPMAP_NEAREST:
+   case GL_NEAREST_MIPMAP_LINEAR:
+      *filter = GL_NEAREST;
+      break;
+   case GL_LINEAR_MIPMAP_NEAREST:
+   case GL_LINEAR_MIPMAP_LINEAR:
+      *filter = GL_LINEAR;
+      break;
+   default:                     /* GL_NEAREST or GL_LINEAR: no mipmaps */
+      return base;
+   }
+   level = obj->BaseLevel + (GLint) (lod + 0.5F);
+   if (level > obj->_MaxLevel)
+      level = obj->_MaxLevel;
+   {
+      /* the fast triangles need the tightly packed rows they were chosen
+         for (checked on the base image) */
+      const struct gl_texture_image *img = obj->Image[0][level];
+      if (img && img->TexFormat == base->TexFormat &&
+          swrast_texture_image_const(img)->ImageSlices &&
+          _mesa_format_row_stride(img->TexFormat, img->Width) ==
+          swrast_texture_image_const(img)->RowStride)
+         return img;
+   }
+   return base;
+}
