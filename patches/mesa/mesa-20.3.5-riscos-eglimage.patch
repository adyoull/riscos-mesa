index 9ccba6b..b60748b 100644
--- a/src/mesa/swrast/s_context.h
+++ b/src/mesa/swrast/s_context.h
@@ -159,6 +159,13 @@ struct swrast_texture_image
    /** Malloc'd texture memory */
    GLubyte *Buffer;
 
+   /**
+    * riscos-mesa: Buffer belongs to someone else (an EGLImage's pixels,
+    * _swrast_set_external_texture_buffer): it is read and written in
+    * place and never freed here.
+    */
+   GLboolean ExternalBuffer;
+
    FetchTexelFunc FetchTexel;
 
