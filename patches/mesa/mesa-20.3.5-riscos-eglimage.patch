diff --git a/include/GL/osmesa.h b/include/GL/osmesa.h
index da61f6a..2592365 100644
--- a/include/GL/osmesa.h
+++ b/include/GL/osmesa.h
@@ -307,6 +307,34 @@ OSMesaGetProcAddress( const char *funcName );
 
 
 
+/*
+ * riscos-mesa: GL_OES_EGL_image.
+ *
+ * An EGL library that makes EGLImages from memory (riscos-mesa's libEGL:
+ * EGL_KHR_image_pixmap on 32bpp sprites) registers a lookup function here.
+ * glEGLImageTargetTexture2DOES(GL_TEXTURE_2D, image) then asks it to
+ * describe the image and makes the bound texture's level 0 use the
+ * image's pixels in place: no copy, and changes to them show at the next
+ * draw. Row 0 of the pixels is t = 0, as with glTexImage2D. The fourth
+ * byte of each pixel is not used (such textures are opaque, GL_RGB).
+ * GL_OES_EGL_image is advertised by contexts created after a lookup
+ * function has been registered.
+ */
+typedef struct OSMesaImage
+{
+   void *pixels;       /* first pixel of row 0 */
+   GLint width, height;
+   GLint row_bytes;    /* bytes from one row to the next, a multiple of 4 */
+   GLenum format;      /* byte order: OSMESA_RGBA (R,G,B,x) or OSMESA_BGRA (B,G,R,x) */
+} OSMesaImage;
+
+/* Fills in *desc and returns GL_TRUE if image is a valid image handle */
+typedef GLboolean (*OSMesaImageLookupFunc)(void *image, OSMesaImage *desc);
+
+GLAPI void GLAPIENTRY
+OSMesaSetImageLookup(OSMesaImageLookupFunc lookup);
+
+
 /**
  * Enable/disable color clamping, off by default.
  * New in Mesa 6.4.2
diff --git a/src/mesa/drivers/osmesa/osmesa.c b/src/mesa/drivers/osmesa/osmesa.c
index 0993d2b..807043c 100644
--- a/src/mesa/drivers/osmesa/osmesa.c
+++ b/src/mesa/drivers/osmesa/osmesa.c
@@ -45,6 +45,7 @@
 #include "main/mipmap.h"
 #include "main/mtypes.h"
 #include "main/renderbuffer.h"
+#include "main/teximage.h"
 #include "main/version.h"
 #include "main/vtxfmt.h"
 #include "swrast/swrast.h"
@@ -804,6 +805,68 @@ set_size_limits(struct gl_context *ctx)
 }
 
 
+/**
+ * riscos-mesa: GL_OES_EGL_image. The EGL library registers a function
+ * that turns an EGLImage handle into a description of its pixels
+ * (OSMesaSetImageLookup, GL/osmesa.h); a texture made from the image uses
+ * those pixels in place (_swrast_set_external_texture_buffer).
+ */
+static OSMesaImageLookupFunc image_lookup;
+
+static void
+egl_image_target_texture_2d(struct gl_context *ctx, GLenum target,
+                            struct gl_texture_object *texObj,
+                            struct gl_texture_image *texImage,
+                            GLeglImageOES image)
+{
+   const char *func = "glEGLImageTargetTexture2DOES";
+   OSMesaImage desc;
+   mesa_format format;
+
+   (void) target;
+   (void) texObj;
+   if (!image_lookup || !image_lookup(image, &desc)) {
+      _mesa_error(ctx, GL_INVALID_VALUE, "%s(image)", func);
+      return;
+   }
+
+   /* The pixels' fourth byte isn't used: the texture is GL_RGB */
+   if (desc.format == OSMESA_RGBA)
+      format = MESA_FORMAT_R8G8B8X8_UNORM;   /* bytes R,G,B,x */
+   else if (desc.format == OSMESA_BGRA)
+      format = MESA_FORMAT_B8G8R8X8_UNORM;   /* bytes B,G,R,x */
+   else
+      format = MESA_FORMAT_NONE;
+   if (format == MESA_FORMAT_NONE || !desc.pixels ||
+       desc.width < 1 || desc.width > ctx->Const.MaxTextureSize ||
+       desc.height < 1 || desc.height > ctx->Const.MaxTextureSize ||
+       desc.row_bytes < desc.width * 4 || desc.row_bytes % 4 != 0) {
+      _mesa_error(ctx, GL_INVALID_OPERATION, "%s(image can't be a texture)", func);
+      return;
+   }
+
+   _mesa_init_teximage_fields(ctx, texImage, desc.width, desc.height, 1, 0,
+                              GL_RGB, format);
+   if (!_swrast_set_external_texture_buffer(texImage, desc.pixels,
+                                            desc.row_bytes)) {
+      _mesa_init_teximage_fields(ctx, texImage, 0, 0, 0, 0, GL_NONE,
+                                 MESA_FORMAT_NONE);
+      _mesa_error(ctx, GL_OUT_OF_MEMORY, "%s", func);
+   }
+}
+
+/* Rendering into an EGLImage isn't supported */
+static void
+egl_image_target_renderbuffer(struct gl_context *ctx,
+                              struct gl_renderbuffer *rb, void *image)
+{
+   (void) rb;
+   (void) image;
+   _mesa_error(ctx, GL_INVALID_OPERATION,
+               "glEGLImageTargetRenderbufferStorageOES(not supported)");
+}
+
