diff --git a/src/mesa/swrast/s_texture.c b/src/mesa/swrast/s_texture.c
index 24fddd7..3c5cbc3 100644
--- a/src/mesa/swrast/s_texture.c
+++ b/src/mesa/swrast/s_texture.c
@@ -167,14 +167,44 @@ _swrast_free_texture_image_buffer(struct gl_context *ctx,
 {
    struct swrast_texture_image *swImage = swrast_texture_image(texImage);
 
-   align_free(swImage->Buffer);
+   if (!swImage->ExternalBuffer)
+      align_free(swImage->Buffer);
    swImage->Buffer = NULL;
+   swImage->ExternalBuffer = GL_FALSE;
 
    free(swImage->ImageSlices);
    swImage->ImageSlices = NULL;
 }
 
 
+/**
+ * riscos-mesa: make a 2D texture image use memory it doesn't own (an
+ * EGLImage's pixels, GL_OES_EGL_image) instead of allocating its own.
+ * The caller has set up the image's fields (_mesa_init_teximage_fields)
+ * after the old buffer was freed. Texels are then read (and, by
+ * glTexSubImage2D, written) in place, so changes to the memory show at
+ * the next draw; the memory must stay valid while the image uses it.
+ * rowStride is in bytes. Returns GL_FALSE if out of memory.
+ */
+GLboolean
+_swrast_set_external_texture_buffer(struct gl_texture_image *texImage,
+                                    GLubyte *buffer, GLint rowStride)
+{
+   struct swrast_texture_image *swImg = swrast_texture_image(texImage);
+
+   assert(texture_slices(texImage) == 1);
+   assert(!swImg->Buffer);
+   if (!_swrast_init_texture_image(texImage))
+      return GL_FALSE;
+
+   swImg->Buffer = buffer;
+   swImg->ExternalBuffer = GL_TRUE;
+   swImg->RowStride = rowStride;
+   swImg->ImageSlices[0] = buffer;
+   return GL_TRUE;
+}
+
