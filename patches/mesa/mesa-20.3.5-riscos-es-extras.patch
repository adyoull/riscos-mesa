+/*
+ * riscos-mesa: ETC1 textures (GL_OES_compressed_ETC1_RGB8_texture) are
+ * decoded when they are loaded and kept as an ordinary RGB texture, so
+ * they draw through the textured-triangle fast paths instead of decoding
+ * every texel as it is sampled. The application sees an ETC1 texture
+ * (its internal format), and only glCompressedTex(Sub)Image2D can load it.
+ */
+static mesa_format
+etc1_decoded_format(struct gl_context *ctx, struct gl_texture_object *texObj,
+                    GLenum target, GLint level)
+{
+   return _mesa_choose_texture_format(ctx, texObj, target, level,
+                                      GL_RGB8, GL_RGBA, GL_UNSIGNED_BYTE);
+}
+
+/* Decode width x height texels of ETC1 blocks (a PBO offset or pointer)
+ * and hand them to the driver as RGBA bytes: the whole image when
+ * sub == false, else the region at xoffset, yoffset. */
+static void
+etc1_load(struct gl_context *ctx, GLuint dims,
+          struct gl_texture_image *texImage, GLboolean sub,
+          GLint xoffset, GLint yoffset, GLint zoffset,
+          GLsizei width, GLsizei height, GLsizei depth,
+          GLsizei imageSize, const GLvoid *data)
+{
+   const GLubyte *src;
+   GLubyte *rgba;
+   src = _mesa_validate_pbo_compressed_teximage(ctx, dims, imageSize, data,
+                                                &ctx->Unpack,
+                                                sub ? "glCompressedTexSubImage"
+                                                    : "glCompressedTexImage");
+   if (!src)
+      return;
+   rgba = malloc((size_t) width * height * 4);
+   if (!rgba) {
+      _mesa_unmap_teximage_pbo(ctx, &ctx->Unpack);
+      _mesa_error(ctx, GL_OUT_OF_MEMORY, "glCompressedTexImage");
+      return;
+   }
+   _mesa_etc1_unpack_rgba8888(rgba, width * 4, src, ((width + 3) / 4) * 8,
+                              width, height);
+   _mesa_unmap_teximage_pbo(ctx, &ctx->Unpack);
+
+   /* ctx->DefaultPacking: tightly packed, no PBO */
+   if (sub)
+      ctx->Driver.TexSubImage(ctx, dims, texImage, xoffset, yoffset, zoffset,
+                              width, height, depth, GL_RGBA, GL_UNSIGNED_BYTE,
+                              rgba, &ctx->DefaultPacking);
+   else
+      ctx->Driver.TexImage(ctx, dims, texImage, GL_RGBA, GL_UNSIGNED_BYTE,
+                           rgba, &ctx->DefaultPacking);
+   free(rgba);
+}
