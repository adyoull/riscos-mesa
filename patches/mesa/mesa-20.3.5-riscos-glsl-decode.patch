+/*
+ * riscos-mesa: pre-decoded programs.
+ *
+ * _mesa_execute_program runs the whole program once per fragment (or
+ * vertex), and every operand used to be decoded again each time: the
+ * register file switch, range checks, swizzle and negate bits.  Here each
+ * instruction's operands are decoded once into a base index (which of a
+ * few per-call base pointers) and an offset, with the swizzle unpacked.
+ * The arithmetic in _mesa_execute_program is unchanged, so results are
+ * the same bit for bit.  Operands with relative addressing, and anything
+ * unusual, take the original path.
+ *
+ * The decoded copy lives in the machine and is checked against the
+ * program (a saved copy of its instructions and parameter offsets) once
+ * per span or vertex batch, when the caller has cleared DecodedChecked.
+ */
+enum {
+   PB_ZERO,     /* ZeroVec: out-of-range source registers */
+   PB_TEMP,     /* machine->Temporaries */
+   PB_INPUT,    /* this fragment's Attribs, or VertAttribs */
+   PB_OUTPUT,   /* machine->Outputs */
+   PB_PARAM,    /* program->Parameters->ParameterValues */
+   PB_SYSVAL,   /* machine->SystemValues */
+   PB_DUMMY,    /* out-of-range destination registers */
+   PB_COUNT
+};
+
+#define PF_NOSWZ 1   /* swizzle is .xyzw */
+#define PF_NEG   2   /* negate */
+#define PF_SLOW  4   /* use the original code */
+
+struct dec_src {
+   GLint off;          /* in floats from the base */
+   GLubyte base;
+   GLubyte flags;
+   GLubyte swz[4];
+};
+
+struct dec_dst {
+   GLint off;
+   GLubyte base;
+   GLubyte slow;
+};
+
+struct dec_inst {
+   struct dec_src src[3];
+   struct dec_dst dst;
+};
+
+struct prog_decoded {
+   const struct gl_program *prog;
+   const struct prog_instruction *insts;   /* the program's array ... */
+   struct prog_instruction *copy;          /* ... and its contents */
+   GLuint num, capInst;
+   const struct gl_program_parameter_list *params;
+   GLuint numParams, capParams;
+   unsigned *pvo;                          /* ParameterValueOffset copy */
+   struct dec_inst *d;
+};
+
+/* For when there's no memory for the decoded copy: every operand slow. */
+static const struct dec_inst AllSlow = {
+   { { 0, PB_ZERO, PF_SLOW, { 0, 1, 2, 3 } },
+     { 0, PB_ZERO, PF_SLOW, { 0, 1, 2, 3 } },
+     { 0, PB_ZERO, PF_SLOW, { 0, 1, 2, 3 } } },
+   { 0, PB_DUMMY, 1 }
+};
+
+
+static void
+decode_src(const struct gl_program *prog, const struct prog_src_register *src,
+           struct dec_src *d)
+{
+   const GLint reg = src->Index;
+   GLuint i;
+
+   d->off = 0;
+   d->base = PB_ZERO;
+   d->flags = 0;
+   for (i = 0; i < 4; i++)
+      d->swz[i] = GET_SWZ(src->Swizzle, i);
+   if (src->Swizzle == SWIZZLE_NOOP)
+      d->flags |= PF_NOSWZ;
+   if (src->Negate)
+      d->flags |= PF_NEG;
+
+   if (src->RelAddr || reg < 0) {
+      d->flags |= PF_SLOW;
+      return;
+   }
+
+   switch (src->File) {
+   case PROGRAM_TEMPORARY:
+      if (reg < MAX_PROGRAM_TEMPS) {
+         d->base = PB_TEMP;
+         d->off = reg * 4;
+      }
+      break;
+   case PROGRAM_INPUT:
+      if (prog->Target == GL_VERTEX_PROGRAM_ARB) {
+         if (reg < VERT_ATTRIB_MAX) {
+            d->base = PB_INPUT;
+            d->off = reg * 4;
+         }
+      }
+      else if (reg < VARYING_SLOT_MAX) {
+         d->base = PB_INPUT;
+         d->off = reg * PROG_MAX_WIDTH * 4;
+      }
+      break;
+   case PROGRAM_OUTPUT:
+      if (reg < MAX_PROGRAM_OUTPUTS) {
+         d->base = PB_OUTPUT;
+         d->off = reg * 4;
+      }
+      break;
+   case PROGRAM_STATE_VAR:
+   case PROGRAM_CONSTANT:
+   case PROGRAM_UNIFORM:
+      if (reg < (GLint) prog->Parameters->NumParameters) {
+         d->base = PB_PARAM;
+         d->off = prog->Parameters->ParameterValueOffset[reg];
+      }
+      break;
+   case PROGRAM_SYSTEM_VALUE:
+      if (reg < SYSTEM_VALUE_MAX) {
+         d->base = PB_SYSVAL;
+         d->off = reg * 4;
+      }
+      else
+         d->flags |= PF_SLOW;
+      break;
+   default:
+      d->flags |= PF_SLOW;   /* the original reports the problem */
+      break;
+   }
+}
+
+
+static void
+decode_dst(const struct prog_dst_register *dst, struct dec_dst *d)
+{
+   const GLint reg = dst->Index;
+
+   d->off = 0;
+   d->base = PB_DUMMY;
+   d->slow = 0;
+
+   if (dst->RelAddr) {
+      d->slow = 1;
+      return;
+   }
+
+   switch (dst->File) {
+   case PROGRAM_TEMPORARY:
+      if (reg < MAX_PROGRAM_TEMPS) {
+         d->base = PB_TEMP;
+         d->off = reg * 4;
+      }
+      break;
+   case PROGRAM_OUTPUT:
+      if (reg < MAX_PROGRAM_OUTPUTS) {
+         d->base = PB_OUTPUT;
+         d->off = reg * 4;
+      }
+      break;
+   default:
+      d->slow = 1;   /* the original reports the problem */
+      break;
+   }
+}
+
+
+static GLboolean
+decoded_matches(const struct prog_decoded *dec, const struct gl_program *prog)
+{
+   const struct gl_program_parameter_list *params = prog->Parameters;
+   const GLuint numParams = params ? params->NumParameters : 0;
+
+   return dec->prog == prog &&
+          dec->insts == prog->arb.Instructions &&
+          dec->num == prog->arb.NumInstructions &&
+          dec->params == params &&
+          dec->numParams == numParams &&
+          memcmp(dec->copy, prog->arb.Instructions,
+                 dec->num * sizeof(struct prog_instruction)) == 0 &&
+          (numParams == 0 ||
+           memcmp(dec->pvo, params->ParameterValueOffset,
+                  numParams * sizeof(unsigned)) == 0);
+}
+
+
+/**
+ * Make machine->Decoded match the program.
+ * \return GL_FALSE if out of memory.
+ */
+static GLboolean
+decode_program(struct gl_program_machine *machine,
+               const struct gl_program *prog)
+{
+   struct prog_decoded *dec = machine->Decoded;
+   const GLuint num = prog->arb.NumInstructions;
+   const struct gl_program_parameter_list *params = prog->Parameters;
+   const GLuint numParams = params ? params->NumParameters : 0;
+   GLuint i;
+
+   if (dec && decoded_matches(dec, prog))
+      return GL_TRUE;
+
+   if (!dec) {
+      dec = calloc(1, sizeof(*dec));
+      if (!dec)
+         return GL_FALSE;
+      machine->Decoded = dec;
+   }
+   dec->prog = NULL;   /* invalid until complete */
+
+   if (num > dec->capInst) {
+      free(dec->copy);
+      free(dec->d);
+      dec->copy = malloc(num * sizeof(struct prog_instruction));
+      dec->d = malloc(num * sizeof(struct dec_inst));
+      if (!dec->copy || !dec->d) {
+         free(dec->copy);
+         free(dec->d);
+         dec->copy = NULL;
+         dec->d = NULL;
+         dec->capInst = 0;
+         return GL_FALSE;
+      }
+      dec->capInst = num;
+   }
+   if (numParams > dec->capParams) {
+      free(dec->pvo);
+      dec->pvo = malloc(numParams * sizeof(unsigned));
+      if (!dec->pvo) {
+         dec->capParams = 0;
+         return GL_FALSE;
+      }
+      dec->capParams = numParams;
+   }
+
+   if (num)
+      memcpy(dec->copy, prog->arb.Instructions,
+             num * sizeof(struct prog_instruction));
+   if (numParams)
+      memcpy(dec->pvo, params->ParameterValueOffset,
+             numParams * sizeof(unsigned));
+
+   for (i = 0; i < num; i++) {
+      const struct prog_instruction *inst = prog->arb.Instructions + i;
+      GLuint k;
+      for (k = 0; k < 3; k++)
+         decode_src(prog, &inst->SrcReg[k], &dec->d[i].src[k]);
+      decode_dst(&inst->DstReg, &dec->d[i].dst);
+   }
+
+   dec->insts = prog->arb.Instructions;
+   dec->num = num;
+   dec->params = params;
+   dec->numParams = numParams;
+   dec->prog = prog;
+   return GL_TRUE;
+}
+
+
+void
+_mesa_free_program_machine(struct gl_program_machine *machine)
+{
+   struct prog_decoded *dec = machine->Decoded;
+   if (dec) {
+      free(dec->copy);
+      free(dec->d);
+      free(dec->pvo);
+      free(dec);
+      machine->Decoded = NULL;
+   }
+}
