+/* Operand access through the decoded instruction 'di'; 'bases' holds the
+ * base pointers for this call.  Same arithmetic as fetch_vector4(),
+ * fetch_vector1() and store_vector4().
+ */
+#define FETCH4(N, R)                                                  \
+   do {                                                               \
+      const struct dec_src *ds_ = &di->src[N];                        \
+      if (unlikely(ds_->flags & PF_SLOW)) {                           \
+         fetch_vector4(&inst->SrcReg[N], machine, R);                 \
+      }                                                               \
+      else {                                                          \
+         const GLfloat *s_ = bases[ds_->base] + ds_->off;             \
+         if (ds_->flags & PF_NOSWZ) {                                 \
+            COPY_4V(R, s_);                                           \
+         }                                                            \
+         else {                                                       \
+            (R)[0] = s_[ds_->swz[0]];                                 \
+            (R)[1] = s_[ds_->swz[1]];                                 \
+            (R)[2] = s_[ds_->swz[2]];                                 \
+            (R)[3] = s_[ds_->swz[3]];                                 \
+         }                                                            \
+         if (ds_->flags & PF_NEG) {                                   \
+            (R)[0] = -(R)[0];                                         \
+            (R)[1] = -(R)[1];                                         \
+            (R)[2] = -(R)[2];                                         \
+            (R)[3] = -(R)[3];                                         \
+         }                                                            \
+      }                                                               \
+   } while (0)
+
+#define FETCH1(N, R)                                                  \
+   do {                                                               \
+      const struct dec_src *ds_ = &di->src[N];                        \
+      if (unlikely(ds_->flags & PF_SLOW)) {                           \
+         fetch_vector1(&inst->SrcReg[N], machine, R);                 \
+      }                                                               \
+      else {                                                          \
+         (R)[0] = (bases[ds_->base] + ds_->off)[ds_->swz[0]];         \
+         if (ds_->flags & PF_NEG)                                     \
+            (R)[0] = -(R)[0];                                         \
+      }                                                               \
+   } while (0)
+
+#define STORE4(V)                                                     \
+   do {                                                               \
+      if (unlikely(di->dst.slow)) {                                   \
+         store_vector4(inst, machine, V);                             \
+      }                                                               \
+      else {                                                          \
+         GLfloat *d_ = bases[di->dst.base] + di->dst.off;             \
+         const GLuint wm_ = inst->DstReg.WriteMask;                   \
+         const GLfloat *v_ = (V);                                     \
+         GLfloat c_[4];                                               \
+         if (inst->Saturate) {                                        \
+            c_[0] = CLAMP(v_[0], 0.0F, 1.0F);                         \
+            c_[1] = CLAMP(v_[1], 0.0F, 1.0F);                         \
+            c_[2] = CLAMP(v_[2], 0.0F, 1.0F);                         \
+            c_[3] = CLAMP(v_[3], 0.0F, 1.0F);                         \
+            v_ = c_;                                                  \
+         }                                                            \
+         if (wm_ & WRITEMASK_X)                                       \
+            d_[0] = v_[0];                                            \
+         if (wm_ & WRITEMASK_Y)                                       \
+            d_[1] = v_[1];                                            \
+         if (wm_ & WRITEMASK_Z)                                       \
+            d_[2] = v_[2];                                            \
+         if (wm_ & WRITEMASK_W)                                       \
+            d_[3] = v_[3];                                            \
+      }                                                               \
+   } while (0)
