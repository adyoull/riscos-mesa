+/**
+ * riscos-mesa: a dispatch table for another renderer (GL/osmesa.h). The
+ * table is glapi's own layout, so the entry points (glapi's stubs) use it
+ * as they use OSMesa's: one table per thread, set here.
+ */
+GLAPI void * GLAPIENTRY
+OSMesaMakeDispatchRISCOS(const OSMesaDispatchEntry *list, int n)
+{
+   const unsigned size = _glapi_get_dispatch_table_size();
+   struct _glapi_table *table = _glapi_new_nop_table(size);
+   _glapi_proc *entry = (_glapi_proc *) table;
+   int i;
+
+   if (!table)
+      return NULL;
+   for (i = 0; n < 0 ? list[i].name != NULL : i < n; i++) {
+      const int offset = _glapi_get_proc_offset(list[i].name);
+      if (offset >= 0 && (unsigned) offset < size && list[i].fn)
+         entry[offset] = (_glapi_proc) list[i].fn;
+   }
+   return table;
+}
+
+GLAPI void GLAPIENTRY
+OSMesaSetDispatchRISCOS(void *table)
+{
+   _glapi_set_dispatch((struct _glapi_table *) table);
+}
