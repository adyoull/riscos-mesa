 /*
+ * riscos-mesa: another renderer behind the same GL entry points, for
+ * contexts that EGL gives to RISC3D (a hardware path) instead of OSMesa.
+ *
+ * OSMesaMakeDispatchRISCOS makes a dispatch table from a list of GL
+ * function names and functions (n entries, or up to a null name if n is
+ * negative); names glapi doesn't know are ignored, and anything not in the
+ * list does nothing. OSMesaSetDispatchRISCOS makes a table the calling
+ * thread's current one (NULL: none) once no OSMesa context is current:
+ * every gl* call then goes to the list's functions, at no extra cost.
+ * OSMesaMakeCurrent sets OSMesa's own table again.
+ */
+typedef struct OSMesaDispatchEntry
+{
+   const char *name;
+   void (*fn)(void);
+} OSMesaDispatchEntry;
+
+GLAPI void * GLAPIENTRY
+OSMesaMakeDispatchRISCOS(const OSMesaDispatchEntry *list, int n);
+
+GLAPI void GLAPIENTRY
+OSMesaSetDispatchRISCOS(void *table);
+
+
