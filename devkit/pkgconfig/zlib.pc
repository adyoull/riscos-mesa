# riscos-mesa devkit. The paths are worked out from where this file is,
# so the devkit works wherever you unpack it. Everything is linked
# statically, so Libs lists every library needed, in order.
prefix=${pcfiledir}/../..
includedir=${prefix}/include
libdir=${prefix}/lib

Name: zlib
Description: zlib compression library
Version: 1.3.1
Libs: -L${libdir} -lz
Cflags: -I${includedir}
