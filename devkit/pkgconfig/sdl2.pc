# riscos-mesa devkit. The paths are worked out from where this file is,
# so the devkit works wherever you unpack it. Everything is linked
# statically, so Libs lists every library needed, in order.
prefix=${pcfiledir}/../..
includedir=${prefix}/include
libdir=${prefix}/lib

Name: sdl2
Description: SDL 2.26 with the RISC OS video, OpenGL and sound drivers
Version: 2.26.0
Libs: -L${libdir} -lSDL2 -lGLU -lOSMesa -lstdc++ -lz -lm
Cflags: -I${includedir}/SDL2 -I${includedir} -D_REENTRANT
