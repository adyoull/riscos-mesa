# riscos-mesa devkit. The paths are worked out from where this file is,
# so the devkit works wherever you unpack it. Everything is linked
# statically, so Libs lists every library needed, in order.
prefix=${pcfiledir}/../..
includedir=${prefix}/include
libdir=${prefix}/lib

Name: glut
Description: freeglut 3.8.0 with a native RISC OS back end
Version: 3.8.0
Libs: -L${libdir} -lglut -lGLU -lEGL -lOSMesa -lstdc++ -lz -lm
Cflags: -I${includedir}
